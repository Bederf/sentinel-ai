# Redirect www to non-www
www.sentinel-ai.co.za {
  redir https://sentinel-ai.co.za{uri} permanent
}

# Legacy redirect: aimthelaw → sentinel-ai
bms.aimthelaw.co.za {
  redir https://bms.sentinel-ai.co.za{uri} permanent
}

www.bms.aimthelaw.co.za {
  redir https://bms.sentinel-ai.co.za{uri} permanent
}
