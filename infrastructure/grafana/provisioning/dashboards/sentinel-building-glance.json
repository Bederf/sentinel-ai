    {
      "title": "Equipment Health Status",
      "type": "table",
      "description": "Equipment health scores for site-002, sorted by lowest health first",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "PFE7CEB7816ED0E35"
      },
      "targets": [
        {
          "rawSql": "SELECT e.code AS \"Equipment ID\", e.health_score AS \"Health\", CASE WHEN e.health_score >= 75 THEN 'healthy' WHEN e.health_score < 30 THEN 'critical' ELSE 'warning' END AS \"Status\" FROM equipment e WHERE e.site_id = (SELECT id FROM sites WHERE code = 'site-002' LIMIT 1) AND e.code NOT LIKE '%-LTG-%' AND e.code NOT LIKE '%-DALI-%' AND (e.type IS NULL OR e.type NOT IN ('lighting', 'luminaire', 'Lighting', 'Luminaire', 'LTG', 'DALI', 'dali')) AND e.code NOT LIKE '%-LTG-%' AND e.code NOT LIKE '%-DALI-%' AND (e.type IS NULL OR e.type NOT IN ('zone', 'Zone', 'scene', 'Scene', 'sensor', 'Sensor', 'door', 'Door', 'gate', 'Gate', 'weather', 'Weather', 'meter', 'Meter')) ORDER BY e.health_score ASC NULLS LAST LIMIT 15",
          "refId": "A",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-background-solid",
              "value": false
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#ef4444",
                "value": null
              },
              {
                "color": "#f59e0b",
                "value": 60
              },
              {
                "color": "#10b981",
                "value": 80
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background-solid",
                  "value": true
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showRow": true,
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        }
      }
    },
