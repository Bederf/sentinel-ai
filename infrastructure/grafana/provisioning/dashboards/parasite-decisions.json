      "title": "Tier 3 Auto-Execute Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"sentinel-decisions\", stage=\"pipeline.complete\"} [1h]))",
          "legendFormat": "Successful Auto-Executes",
          "refId": "A"
