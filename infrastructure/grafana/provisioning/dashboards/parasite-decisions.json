      "title": "Tier 3 Auto-Execute Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
