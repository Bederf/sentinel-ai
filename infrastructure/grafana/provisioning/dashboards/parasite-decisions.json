        {
          "expr": "sum(count_over_time({job=\"sentinel-decisions\", stage=\"rollback.executed\"} [1h]))",
          "legendFormat": "Auto-Rollbacks",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "stacking": { "mode": "normal" }
          }
        }
      }
    },
    {
      "title": "Tier 2 Approval Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
