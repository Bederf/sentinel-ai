      "targets": [
        {
          "expr": "sum(count_over_time({job=\"sentinel-decisions\", stage=\"approval.decided\", status=\"approved\"} [1h]))",
          "legendFormat": "Approved",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({job=\"sentinel-decisions\", stage=\"approval.decided\", status=\"rejected\"} [1h]))",
          "legendFormat": "Rejected",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "stacking": { "mode": "normal" }
          }
        }
      }
