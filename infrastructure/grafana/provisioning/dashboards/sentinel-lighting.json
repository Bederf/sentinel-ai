{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(245, 135, 30, 0.59)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SENTINEL Lighting monitoring — lux levels, fixture status, energy consumption, occupancy.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Scrape Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "up{job=\"sentinel-backend\"}", "legendFormat": "{{instance}}" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#ef4444", "value": null }, { "color": "#10b981", "value": 1 }] },
          "color": { "mode": "thresholds" },
          "mappings": [{ "type": "value", "options": { "0": { "text": "Down", "color": "#ef4444" } } }, { "type": "value", "options": { "1": { "text": "Up", "color": "#10b981" } } }],
          "sparkline": { "displayMode": "area", "lineColor": "#10b981", "fillColor": "rgba(16, 185, 129, 0.15)" }
        }
      }
    },
    {
      "id": 2,
      "title": "Fixtures On",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 3, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sum(sentinel_lighting_fixtures_on) or vector(0)", "legendFormat": "On" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#10b981", "value": null }, { "color": "#f59e0b", "value": 20 }, { "color": "#ef4444", "value": 50 }] },
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "sparkline": { "displayMode": "area", "lineColor": "#f59e0b", "fillColor": "rgba(245, 158, 11, 0.12)" }
        }
      }
    },
    {
      "id": 3,
      "title": "Lighting Energy",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sum(rate(sentinel_lighting_energy_kwh_total[1h])) * 1000 or vector(0)", "legendFormat": "kWh/h" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#10b981", "value": null }, { "color": "#f59e0b", "value": 50 }, { "color": "#ef4444", "value": 100 }] },
          "color": { "mode": "thresholds" },
          "unit": "kwatth",
          "decimals": 1,
          "sparkline": { "displayMode": "area", "lineColor": "#f59e0b", "fillColor": "rgba(245, 158, 11, 0.12)" }
        }
      }
    },
    {
      "id": 4,
      "title": "Zone Lux Levels",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sentinel_lighting_zone_lux", "legendFormat": "{{zone_name}} ({{site_id}})" }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "lineWidth": 1, "fillOpacity": 20 },
          "color": { "mode": "palette-classic" },
          "decimals": 0
        }
      }
    },
    {
      "id": 5,
      "title": "Fixtures On vs Total",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "expr": "sentinel_lighting_fixtures_on", "legendFormat": "On {{zone_id}}" },
        { "refId": "B", "expr": "sentinel_lighting_fixtures_total", "legendFormat": "Total {{zone_id}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "lineWidth": 1, "fillOpacity": 20 },
          "color": { "mode": "palette-classic" },
          "decimals": 0
        }
      }
    },
    {
      "id": 6,
      "title": "Energy Rate",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "rate(sentinel_lighting_energy_kwh_total[1h]) * 1000", "legendFormat": "{{site_id}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": { "lineWidth": 1, "fillOpacity": 25 },
          "color": { "mode": "palette-classic" },
          "decimals": 1
        }
      }
    },
    {
      "id": 7,
      "title": "Occupancy",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sentinel_lighting_occupancy_percent", "legendFormat": "{{zone_id}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "lineWidth": 1, "fillOpacity": 25 },
          "color": { "mode": "palette-classic" },
          "decimals": 1
        }
      }
    }
  ],
  "refresh": "30s",
  "tags": ["lighting", "sentinel", "building"],
  "templating": {
    "list": [
      { "name": "site", "type": "query", "query": "label_values(sentinel_lighting_zone_lux, site_id)", "multi": true }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "SENTINEL — Lighting",
  "uid": "sentinel-lighting",
  "version": 2
}