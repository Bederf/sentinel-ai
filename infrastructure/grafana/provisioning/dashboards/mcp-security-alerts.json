    },
    {
      "title": "Manifest Drift Events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "count_over_time({job=\"systemd-journal\", unit=\"sentinel-backend.service\"} |~ \"MCP manifest drift\" [5m])",
          "legendFormat": "Manifest Drift",
          "refId": "A"
        }
      ],
      "alert": {
        "name": "MCP Manifest Drift Alarm",
        "conditions": [
          {
            "evaluator": { "params": [1], "type": "gt" },
            "operator": { "type": "and" },
            "query": { "params": ["A", "1m", "now"] },
            "reducer": { "params": [], "type": "avg" },
            "type": "query"
          }
        ],
        "frequency": "1m",
        "for": "1m",
        "message": "MCP tool manifest has drifted at runtime — possible tampering or hot-reload side effect.",
        "noDataState": "no_data",
        "executionErrorState": "alerting"
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "color": { "fixedColor": "purple", "mode": "fixed" }
        }
      }
    },
    {
