{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SIMBIOT MCP Server security monitoring: rate limit hits, auth failures, tool errors, concurrency saturation, and manifest drift.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "MCP Security Overview (1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "count_over_time({job=\"systemd-journal\", unit=\"sentinel-backend.service\"} |~ \"MCP rate limit|MCP auth failure|MCP manifest drift\" [1h])",
          "legendFormat": "MCP Security Events (1h)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "title": "Rate Limit Hits / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "count_over_time({job=\"systemd-journal\", unit=\"sentinel-backend.service\"} |~ \"MCP rate limit\" [1m])",
          "legendFormat": "Rate Limit Hits",
          "refId": "A"
        }
      ],
      "alert": {
        "name": "MCP Rate Limit Alarm",
        "conditions": [
          {
            "evaluator": { "params": [10], "type": "gt" },
            "operator": { "type": "and" },
            "query": { "params": ["A", "5m", "now"] },
            "reducer": { "params": [], "type": "avg" },
            "type": "query"
          }
        ],
        "frequency": "1m",
        "for": "5m",
        "message": "MCP rate limit hits exceed 10/min for 5 minutes — possible abuse or misconfigured client.",
        "noDataState": "no_data",
        "executionErrorState": "alerting"
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Auth Failures / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "count_over_time({job=\"systemd-journal\", unit=\"sentinel-backend.service\"} |~ \"MCP auth failure|invalid MCP token|Invalid MCP authentication\" [1m])",
          "legendFormat": "Auth Failures",
          "refId": "A"
        }
      ],
      "alert": {
        "name": "MCP Auth Failure Alarm",
        "conditions": [
          {
            "evaluator": { "params": [5], "type": "gt" },
            "operator": { "type": "and" },
            "query": { "params": ["A", "5m", "now"] },
            "reducer": { "params": [], "type": "avg" },
            "type": "query"
          }
        ],
        "frequency": "1m",
        "for": "5m",
        "message": "MCP auth failures exceed 5/min for 5 minutes — possible brute force or token rotation issue.",
        "noDataState": "no_data",
        "executionErrorState": "alerting"
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "color": { "fixedColor": "red", "mode": "fixed" }
        }
      }
    },
    {
      "title": "Tool Errors / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "count_over_time({job=\"systemd-journal\", unit=\"sentinel-backend.service\"} |~ \"Tool execution error|internal_error|TIMEOUT\" |~ \"mcp\" [1m])",
          "legendFormat": "Tool Errors",
          "refId": "A"
        }
      ],
      "alert": {
        "name": "MCP Tool Error Alarm",
        "conditions": [
          {
            "evaluator": { "params": [5], "type": "gt" },
            "operator": { "type": "and" },
            "query": { "params": ["A", "5m", "now"] },
            "reducer": { "params": [], "type": "avg" },
            "type": "query"
          }
        ],
        "frequency": "1m",
        "for": "5m",
        "message": "MCP tool errors exceed 5/min — investigate handler failures or timeouts.",
        "noDataState": "no_data",
        "executionErrorState": "alerting"
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
