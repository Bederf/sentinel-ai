{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(245, 135, 30, 0.59)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SENTINEL Water monitoring — consumption kL, flow rates, leaks, tank levels, cost.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Scrape Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "up{job=\"sentinel-backend\"}", "legendFormat": "{{instance}}" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#ef4444", "value": null }, { "color": "#10b981", "value": 1 }] },
          "color": { "mode": "thresholds" },
          "mappings": [{ "type": "value", "options": { "0": { "text": "Down", "color": "#ef4444" } } }, { "type": "value", "options": { "1": { "text": "Up", "color": "#10b981" } } }],
          "sparkline": { "displayMode": "area", "lineColor": "#10b981", "fillColor": "rgba(16, 185, 129, 0.15)" }
        }
      }
    },
    {
      "id": 2,
      "title": "Active Leaks",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 3, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sum(sentinel_water_leaks_detected) or vector(0)", "legendFormat": "Leaks" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#10b981", "value": null }, { "color": "#ef4444", "value": 1 }] },
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "sparkline": { "displayMode": "area", "lineColor": "#ef4444", "fillColor": "rgba(239, 68, 68, 0.15)" }
        }
      }
    },
    {
      "id": 3,
      "title": "Water Cost",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 7, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sum(sentinel_water_cost_zar) or vector(0)", "legendFormat": "ZAR" }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyZAR",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#10b981", "value": null }, { "color": "#f59e0b", "value": 5000 }, { "color": "#ef4444", "value": 20000 }] },
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "sparkline": { "displayMode": "area", "lineColor": "#f59e0b", "fillColor": "rgba(245, 158, 11, 0.1)" }
        }
      }
    },
    {
      "id": 4,
      "title": "Consumption",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "rate(sentinel_water_consumption_kl_total[1h]) * 1000", "legendFormat": "{{site_id}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "lineWidth": 1, "fillOpacity": 20 },
          "color": { "mode": "palette-classic" },
          "decimals": 2
        }
      }
    },
    {
      "id": 5,
      "title": "Flow Rate",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sentinel_water_flow_rate_lph", "legendFormat": "{{zone_id}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "lineWidth": 1, "fillOpacity": 20 },
          "color": { "mode": "palette-classic" },
          "decimals": 1
        }
      }
    },
    {
      "id": 6,
      "title": "Tank Levels",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sentinel_water_tank_level_percent", "legendFormat": "{{tank_id}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 1, "fillOpacity": 20 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#ef4444", "value": null }, { "color": "#f59e0b", "value": 30 }, { "color": "#10b981", "value": 60 }] },
          "color": { "mode": "thresholds" },
          "decimals": 1
        }
      }
    },
    {
      "id": 7,
      "title": "Cost Over Time",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sentinel_water_cost_zar", "legendFormat": "{{site_id}} {{period}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyZAR",
          "custom": { "lineWidth": 1, "fillOpacity": 25 },
          "color": { "mode": "palette-classic" },
          "decimals": 0
        }
      }
    }
  ],
  "refresh": "30s",
  "tags": ["water", "sentinel", "building"],
  "templating": {
    "list": [
      { "name": "site", "type": "query", "query": "label_values(sentinel_water_consumption_kl_total, site_id)", "multi": true }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "title": "SENTINEL — Water",
  "uid": "sentinel-water",
  "version": 2
}