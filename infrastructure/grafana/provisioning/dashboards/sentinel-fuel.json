          },
          "decimals": 0
        }
      }
    }
  ],
  "refresh": "60s",
  "tags": [
    "fuel",
    "generator",
    "sentinel",
    "building"
  ],
  "templating": {
    "list": [
      {
        "name": "site",
        "type": "query",
        "query": "label_values(sentinel_fuel_generator_runtime_hours, site_id)",
        "multi": true
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "title": "SENTINEL \u2014 Fuel & Generator",
  "uid": "sentinel-fuel",
  "version": 2
}