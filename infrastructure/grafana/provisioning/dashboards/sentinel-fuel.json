      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_fuel_cost_zar or vector(0)",
          "legendFormat": "{{site_id}}"
        }
