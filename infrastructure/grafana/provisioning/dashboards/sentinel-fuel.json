      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 25
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#ef4444",
                "value": null
              },
              {
                "color": "#f59e0b",
                "value": 20
              },
              {
                "color": "#10b981",
                "value": 50
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        }
      }
    },
    {
      "id": 6,
      "title": "Fuel Consumption",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_fuel_consumption_lph or vector(0)",
          "legendFormat": "{{generator_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 28
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2
        }
      }
    },
    {
      "id": 7,
      "title": "Fuel Cost",
