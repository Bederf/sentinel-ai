{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(245, 135, 30, 0.59)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Live AI Governance metrics - Quality gates, recommendations, model drift, and safety violations",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Recommendations — 24h",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(increase(sentinel_recommendations_total[24h]))",
          "legendFormat": "Recommendations",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#10b981", "value": null },
              { "color": "#f59e0b", "value": 50 },
              { "color": "#ef4444", "value": 200 }
            ]
          },
          "unit": "none",
          "decimals": 0,
          "sparkline": {
            "displayMode": "area",
            "lineColor": "#10b981",
            "fillColor": "rgba(16, 185, 129, 0.15)"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "title": "Auto-Execute — 24h",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(increase(sentinel_recommendations_total{action=\"auto_execute\"}[24h]))",
          "legendFormat": "Auto-Executed",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#10b981", "value": null },
              { "color": "#f59e0b", "value": 10 },
              { "color": "#ef4444", "value": 50 }
            ]
          },
          "unit": "none",
          "decimals": 0,
          "sparkline": {
            "displayMode": "area",
            "lineColor": "#10b981",
            "fillColor": "rgba(16, 185, 129, 0.15)"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "title": "Safety Violations — 24h",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(increase(sentinel_safety_violations_total[24h]))",
          "legendFormat": "Violations",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#10b981", "value": null },
              { "color": "#ef4444", "value": 1 }
            ]
          },
          "unit": "none",
          "decimals": 0,
          "sparkline": {
            "displayMode": "area",
            "lineColor": "#ef4444",
            "fillColor": "rgba(239, 68, 68, 0.15)"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "title": "Model Drift Score",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "avg(sentinel_model_drift_score)",
          "legendFormat": "Drift Score",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#10b981", "value": null },
              { "color": "#f59e0b", "value": 0.3 },
              { "color": "#ef4444", "value": 0.7 }
            ]
          },
          "unit": "percentunit",
          "decimals": 3,
          "sparkline": {
            "displayMode": "area",
            "lineColor": "#f59e0b",
            "fillColor": "rgba(245, 158, 11, 0.15)"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "title": "Recommendations by Action",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (action) (increase(sentinel_recommendations_total[24h]))",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "none",
          "decimals": 0
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "title": "Recommendations by Tier",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (tier) (increase(sentinel_recommendations_total[24h]))",
          "legendFormat": "{{tier}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "none",
          "decimals": 0
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "title": "Quality Gate Evaluations",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (status) (increase(sentinel_quality_gate_evaluations_total[24h]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "none",
          "decimals": 0
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "title": "Recommendation Rate — per hour",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (site_id) (rate(sentinel_recommendations_total[1h]))",
          "legendFormat": "{{site_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          },
          "thresholds": { "mode": "absolute" },
          "unit": "ops",
          "decimals": 2
        }
      }
    },
    {
      "title": "Quality Gate Pass/Fail Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (status) (rate(sentinel_quality_gate_evaluations_total[1h]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "lineWidth": 0,
            "stacking": { "mode": "normal" }
          },
          "thresholds": { "mode": "absolute" },
          "unit": "ops",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "pass" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#10b981", "mode": "fixed" } }]},
          {
            "matcher": { "id": "byName", "options": "fail" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#ef4444", "mode": "fixed" } }]},
          {
            "matcher": { "id": "byName", "options": "warn" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#f59e0b", "mode": "fixed" } }]}
        ]
      }
    },
    {
      "title": "Model Drift Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "avg by (model_type) (sentinel_model_drift_score)",
          "legendFormat": "{{model_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#10b981", "value": null },
              { "color": "#f59e0b", "value": 0.3 },
              { "color": "#ef4444", "value": 0.7 }
            ]
          },
          "unit": "percentunit",
          "decimals": 3
        }
      }
    },
    {
      "title": "Safety Violations",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(sentinel_safety_violations_total[1h]))",
          "legendFormat": "Violations/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "lineWidth": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#10b981", "value": null },
              { "color": "#ef4444", "value": 0.001 }
            ]
          },
          "unit": "ops",
          "decimals": 4
        }
      }
    },
    {
      "title": "Rollbacks and Failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (equipment_type) (rate(sentinel_rollback_total[1h]))",
          "legendFormat": "{{equipment_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "thresholds": { "mode": "absolute" },
          "unit": "ops",
          "decimals": 2
        }
      }
    }
  ],
