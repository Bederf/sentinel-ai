{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SENTINEL ESG / Sustainability monitoring — carbon footprint, energy intensity, renewable %, water intensity, waste.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Scrape Health",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "up{job=\"sentinel-backend\"}", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } }
    },
    {
      "id": 2,
      "title": "Total Carbon Footprint (kg CO2e)",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sum(sentinel_esg_carbon_footprint_kg) or vector(0)", "legendFormat": "kg CO2e" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5000 }, { "color": "red", "value": 20000 }] } } }
    },
    {
      "id": 3,
      "title": "Renewable %",
      "type": "gauge",
      "gridPos": { "h": 3, "w": 4, "x": 10, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "avg(sentinel_esg_renewable_percent) or vector(0)", "legendFormat": "%" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 25 }, { "color": "green", "value": 50 }] } } }
    },
    {
      "id": 4,
      "title": "Energy Intensity (kWh/m²)",
      "type": "gauge",
      "gridPos": { "h": 3, "w": 6, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "avg(sentinel_esg_energy_intensity_kwh_per_sqm) or vector(0)", "legendFormat": "kWh/m²" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 200 }] } } }
    },
    {
      "id": 5,
      "title": "Carbon Footprint Over Time (kg CO2e)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sentinel_esg_carbon_footprint_kg", "legendFormat": "{{site_id}} {{period}} scope={{scope}}" }],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "lineWidth": 2, "fillOpacity": 30 } } }
    },
    {
      "id": 6,
      "title": "Renewable % Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sentinel_esg_renewable_percent", "legendFormat": "{{site_id}} {{period}}" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "lineWidth": 2, "fillOpacity": 30 } } }
    },
    {
      "id": 7,
      "title": "Energy Intensity (kWh/m²)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sentinel_esg_energy_intensity_kwh_per_sqm", "legendFormat": "{{site_id}} {{period}}" }],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "lineWidth": 2, "fillOpacity": 30 } } }
    },
    {
      "id": 8,
      "title": "Water Intensity (L/m²)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sentinel_esg_water_intensity_l_per_sqm", "legendFormat": "{{site_id}} {{period}}" }],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "lineWidth": 2, "fillOpacity": 30 } } }
    },
    {
      "id": 9,
      "title": "Waste by Category (kg)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sentinel_esg_waste_kg", "legendFormat": "{{site_id}} {{category}}" }],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "lineWidth": 2, "fillOpacity": 30 } } }
    }
  ],
  "refresh": "1h",
  "tags": ["esg", "sustainability", "sentinel", "building"],
  "templating": {
    "list": [
      { "name": "site", "type": "query", "query": "label_values(sentinel_esg_carbon_footprint_kg, site_id)", "multi": true }
    ]
  },
  "time": { "from": "now-30d", "to": "now" },
  "title": "SENTINEL ESG Dashboard",
  "uid": "sentinel-esg",
  "version": 1
}
