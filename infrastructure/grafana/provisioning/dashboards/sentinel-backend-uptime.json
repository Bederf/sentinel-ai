    {
      "id": 3,
      "title": "Last Scrape Age",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - sentinel_metrics_last_updated_timestamp{job=\"sentinel-governance\"} or vector(0)",
          "legendFormat": "{{site_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              },
              {
                "color": "#f59e0b",
                "value": 15
              },
              {
                "color": "#ef4444",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "sparkline": {}
        }
      }
    },
    {
      "id": 4,
      "title": "API Health \u2014 MCP Endpoint",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_http_requests_total{job=\"sentinel-governance\", path=\"/api/health\", status_code=\"200\"} > 0 or vector(0)",
          "legendFormat": "MCP Health"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#ef4444",
                "value": null
              },
              {
                "color": "#10b981",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unreachable"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Healthy"
                }
              }
            }
          ],
          "sparkline": {}
        }
      }
    },
    {
      "id": 5,
      "title": "HTTP Request Rate \u2014 Last 5m",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(sentinel_http_requests_total{job=\"sentinel-governance\"}[5m]) or vector(0)",
          "legendFormat": "{{method}} {{path}} {{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Error Rate \u2014 Last 5m",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(sentinel_http_requests_total{job=\"sentinel-governance\", status_code=~\"5..\"}[5m]) or vector(0)",
          "legendFormat": "{{method}} {{path}} {{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#ef4444",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "title": "Supabase Query Duration",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, rate(sentinel_db_query_duration_seconds_bucket[5m])) or vector(0)",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, rate(sentinel_db_query_duration_seconds_bucket[5m])) or vector(0)",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1
          }
        }
      }
    },
