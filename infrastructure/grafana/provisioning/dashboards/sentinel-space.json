  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Scrape Health",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"sentinel-governance|sentinel-discipline\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#ef4444",
                "value": null
              },
              {
                "color": "#10b981",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "#ef4444"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Up",
                  "color": "#10b981"
                }
              }
            }
          ],
          "sparkline": {
            "displayMode": "area",
            "lineColor": "#10b981",
            "fillColor": "rgba(16, 185, 129, 0.15)"
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Avg Occupancy",
      "type": "gauge",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 3,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(sentinel_space_occupancy_percent) or vector(0)",
          "legendFormat": "Avg %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#ef4444",
                "value": null
              },
              {
                "color": "#f59e0b",
                "value": 30
              },
              {
                "color": "#10b981",
                "value": 60
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        }
      }
    },
    {
      "id": 3,
      "title": "Occupied Desks",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
