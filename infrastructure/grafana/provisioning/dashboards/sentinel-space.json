      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sentinel_space_occupied_desks) or vector(0)",
          "legendFormat": "Occupied"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              },
              {
                "color": "#f59e0b",
                "value": 20
              },
              {
                "color": "#ef4444",
                "value": 50
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "sparkline": {
            "displayMode": "area",
            "lineColor": "#10b981",
            "fillColor": "rgba(16, 185, 129, 0.12)"
