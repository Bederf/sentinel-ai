  "panels": [
    {
      "title": "Security Overview \u2014 24h",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "count_over_time({job=\"systemd-journal\", unit=\"sentinel-backend.service\"} |~ \"AUTH_FAILURE|ACCESS_DENIED|SUSPICIOUS|BOLA_\" [24h]) or vector(0)",
          "legendFormat": "Security Events (24h)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              },
              {
                "color": "#f59e0b",
                "value": 10
              },
              {
                "color": "#ef4444",
                "value": 50
              }
            ]
          },
          "unit": "none",
          "decimals": 0,
          "sparkline": {
            "displayMode": "area",
            "lineColor": "#f59e0b",
            "fillColor": "rgba(245, 158, 11, 0.15)"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "title": "Failed Login Rate \u2014 by IP",
      "description": "Failed authentication attempts grouped by source IP. Alert threshold: >5 in 5 minutes.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "sum by (source_ip) (count_over_time({job=\"sentinel-security\", event_type=\"AUTH_FAILURE\"} [5m])) or vector(0)",
          "legendFormat": "{{source_ip}}",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({job=\"systemd-journal\", unit=\"sentinel-backend.service\"} |~ \"AUTH_FAILURE\" [5m])) or vector(0)",
          "legendFormat": "Total (journal)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              },
              {
                "color": "#f59e0b",
                "value": 3
              },
              {
                "color": "#ef4444",
                "value": 5
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Total (journal)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#f59e0b",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.fillOpacity",
                "value": 20
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      }
    },
