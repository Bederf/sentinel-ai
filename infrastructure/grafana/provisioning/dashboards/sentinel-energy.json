{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SENTINEL Energy monitoring — consumption kWh, demand kW, cost ZAR, tariff optimization savings.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Scrape Health",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"sentinel-backend\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Total Energy Cost (ZAR)",
      "type": "stat",
      "gridPos": { "h": 3, "w": 5, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sentinel_energy_cost_zar) or vector(0)",
          "legendFormat": "Current period"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10000 },
              { "color": "red", "value": 50000 }
            ]
          },
          "unit": "currencyZAR"
        }
      }
    },
    {
      "id": 3,
      "title": "Current Demand (kW)",
      "type": "stat",
      "gridPos": { "h": 3, "w": 5, "x": 9, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sentinel_energy_demand_kw) or vector(0)",
          "legendFormat": "kW"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "kwatth"
        }
      }
    },
    {
      "id": 4,
      "title": "Tariff Optimization Savings (ZAR)",
      "type": "stat",
      "gridPos": { "h": 3, "w": 5, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sentinel_energy_tariff_optimization_savings_zar) or vector(0)",
          "legendFormat": "Savings"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 500 }
            ]
          },
          "unit": "currencyZAR"
        }
      }
    },
    {
      "id": 5,
      "title": "Total Consumption (kWh)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_energy_total_kwh",
          "legendFormat": "{{site_id}} {{period}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 30
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Demand (kW) Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_energy_demand_kw",
          "legendFormat": "{{site_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 30
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Energy Cost (ZAR)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_energy_cost_zar",
          "legendFormat": "{{site_id}} {{period}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyZAR",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 30
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Peak Demand (kW)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_energy_peak_demand_kw",
          "legendFormat": "{{site_id}} {{month}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 30
          }
        }
      }
    },
    {
      "id": 9,
      "title": "HVAC % of Total Energy",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 4, "x": 16, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(sentinel_energy_hvac_percent) or vector(0)",
          "legendFormat": "Avg HVAC%"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 40 },
              { "color": "red", "value": 60 }
            ]
          },
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 10,
      "title": "Lighting kWh",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 4, "x": 20, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_energy_lighting_kwh",
          "legendFormat": "{{site_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 30
          }
        }
      }
    },
    {
      "id": 11,
      "title": "Carbon Emissions (kg CO2)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_energy_carbon_kg",
          "legendFormat": "{{site_id}} {{period}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 30
          }
        }
      }
    }
  ],
  "refresh": "30s",
  "tags": ["energy", "sentinel", "building"],
  "templating": {
    "list": [
      {
        "name": "site",
        "type": "query",
        "query": "label_values(sentinel_energy_total_kwh, site_id)",
        "multi": true
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "title": "SENTINEL Energy Dashboard",
  "uid": "sentinel-energy",
  "version": 1
}
