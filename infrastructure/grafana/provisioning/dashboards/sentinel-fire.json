{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(245, 135, 30, 0.59)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SENTINEL Fire Safety monitoring — panel status, detector faults, evacuation readiness, extinguisher expiry.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Scrape Health",
      "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "up{job=\"sentinel-backend\"}", "legendFormat": "{{instance}}" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#ef4444", "value": null }, { "color": "#10b981", "value": 1 }] },
          "color": { "mode": "thresholds" },
          "mappings": [{ "type": "value", "options": { "0": { "text": "Down", "color": "#ef4444" } } }, { "type": "value", "options": { "1": { "text": "Up", "color": "#10b981" } } }],
          "sparkline": { "displayMode": "area", "lineColor": "#10b981", "fillColor": "rgba(16, 185, 129, 0.15)" }
        }
      }
    },
    {
      "id": 2,
      "title": "Panels with Faults",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 3, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "count(sentinel_fire_detector_faults > 0) or vector(0)", "legendFormat": "Fault panels" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#10b981", "value": null }, { "color": "#ef4444", "value": 1 }] },
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "sparkline": { "displayMode": "area", "lineColor": "#ef4444", "fillColor": "rgba(239, 68, 68, 0.15)" }
        }
      }
    },
    {
      "id": 3,
      "title": "Evacuation Status",
      "type": "stat",
      "gridPos": { "h": 3, "w": 5, "x": 7, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sum(sentinel_fire_evacuation_status)", "legendFormat": "Evac status" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#10b981", "value": 0 }, { "color": "#f59e0b", "value": 1 }, { "color": "#ef4444", "value": 2 }] },
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Ready", "color": "#10b981" } } },
            { "type": "value", "options": { "1": { "text": "Partial", "color": "#f59e0b" } } },
            { "type": "value", "options": { "2": { "text": "Active", "color": "#ef4444" } } }
          ],
          "decimals": 0
        }
      }
    },
    {
      "id": 4,
      "title": "Fire Panel Status",
      "type": "table",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sentinel_fire_panel_status", "format": "table", "legendFormat": "" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Offline", "color": "#ef4444" } } },
            { "type": "value", "options": { "1": { "text": "Normal", "color": "#10b981" } } },
            { "type": "value", "options": { "2": { "text": "Fault", "color": "#f59e0b" } } },
            { "type": "value", "options": { "3": { "text": "Evacuation", "color": "#ef4444" } } }
          ],
          "custom": { "align": "left", "filterable": true }
        }
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Value", "desc": false }] }
    },
    {
      "id": 5,
      "title": "Detector Faults per Panel",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sentinel_fire_detector_faults", "legendFormat": "{{panel_id}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "lineWidth": 1, "fillOpacity": 25 },
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#10b981", "value": null }, { "color": "#f59e0b", "value": 1 }, { "color": "#ef4444", "value": 5 }] },
          "color": { "mode": "thresholds" },
          "decimals": 0
        }
      }
    },
    {
      "id": 6,
      "title": "Extinguisher Expiry Countdown",
      "type": "table",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "refId": "A", "expr": "sentinel_fire_extinguisher_expiry_days", "format": "table", "legendFormat": "" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#ef4444", "value": null }, { "color": "#f59e0b", "value": 30 }, { "color": "#10b981", "value": 90 }] },
          "unit": "none",
          "color": { "mode": "thresholds" },
          "decimals": 0
        }
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Value", "desc": true }] }
    }
  ],
  "refresh": "60s",
  "tags": ["fire", "sentinel", "building"],
  "templating": {
    "list": [
      { "name": "site", "type": "query", "query": "label_values(sentinel_fire_panel_status, site_id)", "multi": true }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "SENTINEL — Fire Safety",
  "uid": "sentinel-fire",
  "version": 2
}