bms.aimthelaw.co.za {
    # Serve frontend static files from dist
    root * /opt/bms-intelligence/frontend/dist

    # API requests go to backend
    # Note: Backend handles CORS via FastAPI middleware in startup/middleware.py
    # This allows dynamic CORS checking and support for both production + localhost
    reverse_proxy /api/* localhost:9095 {
        # Pass through Origin header to backend for CORS handling
        header_up Origin {http.request.header.Origin}
    }

    # SPA fallback - route all non-API requests to index.html
    try_files {path} /index.html

    # File serving
    file_server

    # Security headers
    header X-Frame-Options "DENY"
    header X-Content-Type-Options "nosniff"
    header X-XSS-Protection "1; mode=block"
    header Referrer-Policy "strict-origin-when-cross-origin"

    # Enable gzip compression
    encode gzip
}
