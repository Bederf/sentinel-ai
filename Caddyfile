{
    http_port 8090
    https_port 8443
}

:8090 {
    # API → backend
    handle /api/* {
        reverse_proxy 127.0.0.1:9095 {
            header_up Origin "https://bms.sentinel-ai.co.za"
        }
    }

    # Static assets → frontend (vite preview)
    handle /assets/* {
        reverse_proxy 127.0.0.1:9096
    }

    # Everything else → frontend
    handle {
        reverse_proxy 127.0.0.1:9096
    }
}
