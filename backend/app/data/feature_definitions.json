{
  "version": "1.0.0",
  "description": "Feature definitions for ML training datasets. Features are computed from InfluxDB sensor data.",
  "common": [
    {
      "name": "temp_mean_7d",
      "dtype": "float",
      "description": "Mean temperature over 7 days",
      "source_sensor": "temperature",
      "aggregation": "mean",
      "window_days": 7
    },
    {
      "name": "temp_std_7d",
      "dtype": "float",
      "description": "Temperature standard deviation over 7 days",
      "source_sensor": "temperature",
      "aggregation": "std",
      "window_days": 7
    },
    {
      "name": "temp_min_7d",
      "dtype": "float",
      "description": "Minimum temperature over 7 days",
      "source_sensor": "temperature",
      "aggregation": "min",
      "window_days": 7
    },
    {
      "name": "temp_max_7d",
      "dtype": "float",
      "description": "Maximum temperature over 7 days",
      "source_sensor": "temperature",
      "aggregation": "max",
      "window_days": 7
    },
    {
      "name": "temp_trend_7d",
      "dtype": "float",
      "description": "Temperature trend (linear regression slope) over 7 days",
      "source_sensor": "temperature",
      "aggregation": "trend",
      "window_days": 7
    },
    {
      "name": "vibration_rms_mean_7d",
      "dtype": "float",
      "description": "Mean RMS vibration over 7 days",
      "source_sensor": "vibration_rms",
      "aggregation": "mean",
      "window_days": 7
    },
    {
      "name": "vibration_rms_max_7d",
      "dtype": "float",
      "description": "Maximum RMS vibration over 7 days",
      "source_sensor": "vibration_rms",
      "aggregation": "max",
      "window_days": 7
    },
    {
      "name": "vibration_trend_7d",
      "dtype": "float",
      "description": "Vibration trend over 7 days",
      "source_sensor": "vibration_rms",
      "aggregation": "trend",
      "window_days": 7
    },
    {
      "name": "runtime_hours_30d",
      "dtype": "float",
      "description": "Total runtime hours over 30 days",
      "source_sensor": "runtime_hours",
      "aggregation": "max",
      "window_days": 30
    },
    {
      "name": "current_mean_7d",
      "dtype": "float",
      "description": "Mean electrical current over 7 days",
      "source_sensor": "current",
      "aggregation": "mean",
      "window_days": 7
    },
    {
      "name": "current_std_7d",
      "dtype": "float",
      "description": "Current standard deviation over 7 days",
      "source_sensor": "current",
      "aggregation": "std",
      "window_days": 7
    }
  ],
  "chiller": [
    {
