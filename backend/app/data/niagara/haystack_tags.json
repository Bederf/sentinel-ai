    "luminaire": {
      "regex": "luminaire|lum[-_]?\\d|led[-_]?downlight|led[-_]?panel|led[-_]?strip|linear[-_]?led|light[-_]?fitting|dali[-_]?lum|dali[-_]?l\\d",
