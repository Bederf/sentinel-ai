  "equipment_patterns": {
    "chiller": {
      "regex": "chiller|chil|ch[-_]?\\d",
      "brick_class": "Chiller",
      "typical_points": ["chw_supply_temp", "chw_return_temp", "condenser_water_temp", "compressor_status", "load_percent"]
    },
    "ahu": {
      "regex": "ahu|air[._-]?handler|air[._-]?handling",
      "brick_class": "Air_Handling_Unit",
      "typical_points": ["supply_air_temp", "return_air_temp", "mixed_air_temp", "filter_dp", "fan_status", "fan_speed"]
    },
    "fcu": {
      "regex": "fcu|fan[._-]?coil",
      "brick_class": "Fan_Coil_Unit",
      "typical_points": ["supply_air_temp", "room_temp", "fan_speed", "valve_position", "setpoint"]
    },
    "vav": {
      "regex": "vav|variable[._-]?air[._-]?volume",
      "brick_class": "Variable_Air_Volume_Box",
      "typical_points": ["discharge_air_temp", "zone_temp", "damper_position", "airflow", "setpoint"]
    },
    "pump": {
      "regex": "pump|pmp",
      "brick_class": "Pump",
      "typical_points": ["discharge_pressure", "suction_pressure", "flow", "speed", "status"]
    },
    "boiler": {
      "regex": "boiler|blr",
      "brick_class": "Boiler",
      "typical_points": ["supply_temp", "return_temp", "firing_rate", "status", "flame_status"]
    },
    "cooling_tower": {
      "regex": "cooling[._-]?tower|ct[-_]?\\d|tower",
      "brick_class": "Cooling_Tower",
      "typical_points": ["water_temp", "fan_speed", "basin_level", "status"]
    },
    "generator": {
      "regex": "generator|gen[-_]?\\d|genset",
      "brick_class": "Generator",
      "typical_points": ["output_kw", "fuel_level", "engine_temp", "frequency", "voltage", "status"]
    },
    "ups": {
      "regex": "ups|uninterruptible",
      "brick_class": "UPS",
      "typical_points": ["battery_level", "load_percent", "input_voltage", "output_voltage", "status"]
    },
    "transformer": {
      "regex": "transformer|xfmr|trafo",
      "brick_class": "Transformer",
      "typical_points": ["primary_voltage", "secondary_voltage", "oil_temp", "load_percent"]
    },
    "dali_controller": {
      "regex": "dali|light[._-]?controller|luminaire|lighting",
      "brick_class": "Lighting_Equipment",
      "typical_points": ["brightness", "power_state", "lux_level", "occupancy"]
    },
    "meter": {
      "regex": "meter|mtr|metering|power[._-]?meter",
      "brick_class": "Meter",
      "typical_points": ["kw", "kwh", "kva", "power_factor", "voltage", "current"]
    }
  },
  "unit_mappings": {
    "degC": ["degc", "celsius", "c", "degrees_c"],
    "degF": ["degf", "fahrenheit", "f", "degrees_f"],
    "kPa": ["kpa", "kilopascals"],
    "Pa": ["pa", "pascals"],
    "psi": ["psi", "pounds_per_square_inch"],
    "%": ["percent", "pct", "%"],
    "L/s": ["l/s", "lps", "liters_per_second"],
    "CFM": ["cfm", "cubic_feet_per_minute"],
    "ppm": ["ppm", "parts_per_million"],
    "kW": ["kw", "kilowatt", "kilowatts"],
    "kWh": ["kwh", "kilowatt_hours"],
    "A": ["amp", "amps", "ampere", "amperes"],
    "V": ["volt", "volts", "vac", "vdc"],
    "Hz": ["hz", "hertz"],
    "RPM": ["rpm", "revolutions_per_minute"]
  },
