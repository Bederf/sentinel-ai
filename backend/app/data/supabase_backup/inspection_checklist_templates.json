[
  {
    "id": "750cea15-8ca0-400d-9cc7-210d7e0d8af4",
    "template_name": "Chiller Monthly Inspection",
    "equipment_type": "chiller",
    "inspection_type": "routine",
    "frequency_type": "monthly",
    "estimated_duration_minutes": 120,
    "is_active": true,
    "version": 1,
    "checklist_items": [
      {
        "method": "bms_sensor_reading",
        "item_id": "ch_001",
        "critical": true,
        "description": "Check suction and discharge pressures",
        "recording_required": [
          "suction_pressure",
          "discharge_pressure"
        ],
        "acceptance_criteria": "Within normal range per baseline, no significant deviation"
      },
      {
        "method": "gauge_measurement",
        "item_id": "ch_002",
        "critical": true,
        "description": "Measure superheat and subcooling",
        "recording_required": [
          "superheat",
          "subcooling",
          "photo"
        ],
        "acceptance_criteria": "Superheat 4-8K, Subcooling 3-7K"
      },
      {
        "method": "electronic_leak_detector",
        "item_id": "ch_003",
        "critical": true,
        "description": "Check for refrigerant leaks",
        "recording_required": [
          "leak_test_result",
          "photo"
        ],
        "acceptance_criteria": "No leaks detected"
      },
      {
        "method": "clamp_meter",
        "item_id": "ch_004",
        "critical": false,
        "description": "Measure compressor motor current",
        "recording_required": [
          "current_l1",
          "current_l2",
          "current_l3"
        ],
        "acceptance_criteria": "Within rated value, balanced across phases"
      },
      {
        "method": "visual_inspection_and_gauge",
        "item_id": "ch_005",
        "critical": true,
        "description": "Check oil level and pressure",
        "recording_required": [
          "oil_level",
          "oil_pressure",
          "photo"
        ],
        "acceptance_criteria": "Level in sight glass, pressure > 2.5 bar"
      },
      {
        "method": "visual_inspection",
        "item_id": "ch_006",
        "critical": false,
        "description": "Inspect condenser coils",
        "recording_required": [
          "cleanliness_rating",
          "photo"
        ],
        "acceptance_criteria": "Clean, no damage, proper airflow"
      },
      {
        "method": "vibration_analyzer",
        "item_id": "ch_007",
        "critical": true,
        "description": "Measure compressor vibration",
        "recording_required": [
          "vibration_rms",
          "spectrum",
          "photo"
        ],
        "acceptance_criteria": "RMS < 1.8 mm/s, no unusual frequencies"
      },
      {
        "method": "control_panel_review",
        "item_id": "ch_008",
        "critical": false,
        "description": "Check control panel alarms and status",
        "recording_required": [
          "alarm_status",
          "photo_of_display"
        ],
        "acceptance_criteria": "No active alarms, all safeties functional"
      }
    ],
    "required_tools": [
      "pressure_gauges",
      "thermal_gun",
      "clamp_meter",
      "leak_detector",
      "vibration_analyzer"
    ],
    "required_skills": [
      "chiller_maintenance",
      "refrigeration",
      "vibration_analysis"
    ],
    "safety_requirements": [
      "lockout_tagout",
      "refrigerant_handling_cert",
      "confined_space"
    ],
    "ppe_required": [
      "safety_glasses",
      "gloves",
      "refrigerant_gloves",
      "face_shield"
    ],
