# BMS Intelligence Backend Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=BMS Intelligence
APP_VERSION=13.2
DEBUG=false
ENVIRONMENT=development

# =============================================================================
# Demo Mode
# =============================================================================
# Set to true for development/demo mode (bypasses authentication, uses mock data)
DEMO_MODE=false

# =============================================================================
# Authentication
# =============================================================================
# JWT secret key (required when DEMO_MODE=false)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-random-secret-key

# JWT token TTL (Phase 65-02)
JWT_ACCESS_TOKEN_TTL_MINUTES=15
# SECURITY: Refresh token TTL - recommended 1-2 days for BMS systems
# Default 7 days is suitable for some deployments; reduce to 24-48 hours for higher security
# Consider shorter TTL if refresh tokens are at risk of being compromised
JWT_REFRESH_TOKEN_TTL_DAYS=7

# =============================================================================
# Authentication Rate Limiting (Phase 58-04 M-5: FSR Domain 4.6)
# =============================================================================
# Brute-force protection on login endpoints
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_LOCKOUT_MINUTES=15
RATE_LIMIT_PER_IP=false
RATE_LIMIT_DEFAULT_RPM=1000
RATE_LIMIT_LOGIN_RPM=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15

# =============================================================================
# Encryption at Rest (Phase 1b FSR Compliance - Cryptography)
# =============================================================================
# Enable AES-128 encryption for sensitive data (audit logs, PII)
# Generate key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_ENABLED=true
ENCRYPTION_KEY=your-base64-encoded-fernet-key-here

# =============================================================================
# Claude AI Settings
# =============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096

# =============================================================================
# Supabase Settings
# =============================================================================
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Use JSON storage as fallback when Supabase is unavailable
USE_JSON_STORAGE=false

# =============================================================================
# Database (Direct PostgreSQL access if needed)
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/bms_intelligence

# =============================================================================
# Redis Cache
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_DEFAULT_TTL=300

# =============================================================================
# Load Shedding (EskomSePush API)
# =============================================================================
ESKOMSEPUsh_API_TOKEN=your_eskomsepush_token
ESKOMSEPUsh_AREA_ID=your_area_id

# =============================================================================
# Niagara BMS Integration
# =============================================================================
NIAGARA_OBIX_HOST=niagara_server.example.com
NIAGARA_OBIX_PORT=80
NIAGARA_OBIX_USERNAME=your_niagara_username
NIAGARA_OBIX_PASSWORD=your_niagara_password
NIAGARA_OBIX_HTTPS=false
NIAGARA_OBIX_TIMEOUT=30
NIAGARA_OBIX_VERIFY_SSL=true

# Niagara BACnet/IP
NIAGARA_BACNET_PORT=47808
NIAGARA_BACNET_LOCAL_IP=

# =============================================================================
# Notification Service (Phase 67-01)
# =============================================================================
# SMTP Configuration for email alerts
NOTIFICATION_SMTP_HOST=smtp.example.com
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USERNAME=sentinel@example.com
NOTIFICATION_SMTP_PASSWORD=your_smtp_password
NOTIFICATION_SMTP_USE_TLS=true

# Slack Webhook URLs for alerts
NOTIFICATION_SLACK_WEBHOOK_CRITICAL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXX
NOTIFICATION_SLACK_WEBHOOK_EMERGENCY=https://hooks.slack.com/services/T00000000/B00000000/YYYYYYYYYYYYYYYY

# Email recipients (comma-separated)
NOTIFICATION_EMAIL_RECIPIENTS=operator1@facility.com,operator2@facility.com,manager@facility.com

# =============================================================================
# SENTRY Telegram Bot Integration (Phase 100 - Secured)
# =============================================================================
# SENTRY bot API key (for authenticated access to /api/sentry/* endpoints)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SENTRY_BOT_API_KEY=your_sentry_bot_api_key

# SENTRY webhook secret (Telegram bot integration)
SENTRY_WEBHOOK_SECRET=your_sentry_webhook_secret

# SENTRY bot JWT authentication (Phase 081 - auto-login to access individual equipment)
# Create a service account user in SENTINEL for the SENTRY bot
# Username for SENTRY service account (e.g., "sentry-bot")
SENTRY_BOT_USERNAME=sentry-bot

# Password for SENTRY service account
# Should be a strong password stored securely (use secrets manager in production)
SENTRY_BOT_PASSWORD=your_sentry_bot_password

# =============================================================================
# WhatsApp Integration (Phase 102 - Technician Notifications)
# =============================================================================
# WhatsApp enables direct technician notifications via WhatsApp Business API
# Two providers supported: Meta (Cloud API) or Twilio. Choose ONE provider.

# --- OPTION A: Meta WhatsApp Cloud API (Recommended) ---
# Setup: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
#
# 1. Create Meta Business Account at business.facebook.com
# 2. Set up WhatsApp Business App
# 3. Get Phone Number ID from WhatsApp app settings
# 4. Generate API token from Meta App Dashboard
#
# Required environment variables:
WHATSAPP_PROVIDER=meta
WHATSAPP_API_TOKEN=your_meta_api_token_here
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ID=your_meta_workspace_id

# --- OPTION B: Twilio WhatsApp (Alternative) ---
# Setup: https://www.twilio.com/docs/whatsapp/quickstart/python
#
# 1. Create Twilio account at twilio.com
# 2. Set up WhatsApp Sandbox or Production number
# 3. Configure phone number to accept incoming messages
#
# To use Twilio, uncomment these and comment out Meta variables above:
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155552671

# --- Common to both providers ---
# Webhook token for verifying incoming webhooks (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
WHATSAPP_WEBHOOK_TOKEN=your_webhook_verification_token

# Enable/disable WhatsApp notifications
WHATSAPP_ENABLED=true

# =============================================================================
# Other Integrations
# =============================================================================
# SIMBIOT Concept Evolution (FSI Public API)
SIMBIOT_API_KEY=your_simbiot_api_key
SIMBIOT_API_URL=https://example.com/simbiot
SIMBIOT_USERNAME=your_simbiot_username
SIMBIOT_PASSWORD=your_simbiot_password
