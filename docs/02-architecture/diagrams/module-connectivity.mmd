graph TB
    %% Core modules (top row)
    control["🎮 Control<br/>Device & Scene Control"]
    assets["📊 Assets<br/>Lifecycle Management"]
    simbiot["🔧 SIMBIOT<br/>Onboarding & Integration"]
    integrations["🔗 Integrations<br/>BMS Connectivity"]
    notifications["📢 Notifications<br/>Alert Delivery"]

    %% Building systems (middle rows)
    hvac["❄️ HVAC<br/>Temperature & Comfort"]
    energy["⚡ Energy<br/>Power & Load Management"]
    lighting["💡 Lighting<br/>DALI Control"]
    security["🔐 Security<br/>Access & Occupancy"]
    solar["☀️ Solar<br/>PV & BESS"]
    fire["🔥 Fire<br/>Safety Systems"]
    access["🚪 Access<br/>Door Control"]

    %% Operations (bottom area)
    sustainability["🌱 Sustainability<br/>ESG & Carbon"]
    water["💧 Water<br/>Consumption"]
    contracts["📝 Contracts<br/>Commercial Mgmt"]

