[Unit]
Description=SENTINEL BMS Backend API
After=network.target

[Service]
Type=simple
User=bederf
Group=bederf
WorkingDirectory=/opt/bms-intelligence/backend
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/opt/bms-intelligence/backend/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/bms-intelligence/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 9095
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel-backend

[Install]
WantedBy=multi-user.target
