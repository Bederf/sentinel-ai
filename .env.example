# =============================================================================
# SENTINEL — Deployment Environment Example
# =============================================================================
#
# Copy this file to `.env` for local Docker/dev-stack usage.
#
#   cp .env.example .env
#
# The backend service consumes these variables directly in containerized runs.
# For the full backend reference, including every supported setting, see:
#   backend/.env.example
#
# =============================================================================

# Core mode
ENVIRONMENT=production
DEBUG=false
DEMO_MODE=false
EDGE_MODE=false

# Local source toggle
ENABLE_SITE002_SOURCE=false
INGESTION_MODE=simulation

# Remote site bridge / SIMBIOT intake
BRIDGE_BASE_URL=http://10.99.0.1:8080
BRIDGE_API_TOKEN=
SIMBIOT_API_URL=
SIMBIOT_API_KEY=
SIMBIOT_USERNAME=
SIMBIOT_PASSWORD=

# Frontend / backend URLs
BACKEND_URL=http://localhost:9095
CORS_ORIGINS=["http://localhost:9096"]

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Auth / encryption
JWT_SECRET_KEY=replace_me
ENCRYPTION_KEY=replace_me

# Influx / Redis
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=sensor_data_raw
REDIS_URL=redis://localhost:6379/0

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://team-jarvis-fnb.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
