### Main Skill Code (index.ts)

```typescript
/**
 * SENTINEL - Building Intelligence Skill for Moltbot
 * Combines HVAC (Desigo) + Lighting (Scenecom) + Knowledge (RAG)
 */

import { Skill, SkillContext, ToolResult } from '@moltbot/sdk';
import { HVACClient } from './lib/hvac-client';
import { DALIClient } from './lib/dali-client';
import { RAGClient } from './lib/rag-client';
import { DeskLookup } from './lib/desk-lookup';
import { AIAnalyzer } from './lib/ai-analyzer';

export default class SentinelSkill extends Skill {
  private hvac: HVACClient;
  private dali: DALIClient;
  private rag: RAGClient;
  private deskLookup: DeskLookup;
  private analyzer: AIAnalyzer;

  async onLoad(ctx: SkillContext) {
    // Initialize clients
    this.hvac = new HVACClient({
      host: ctx.config.get('DESIGO_HOST', '192.168.10.10'),
      deviceId: ctx.config.get('DESIGO_DEVICE_ID', 1000)
    });

    this.dali = new DALIClient({
      redisUrl: ctx.config.get('REDIS_URL', 'redis://localhost:6379')
    });

    this.rag = new RAGClient({
      supabaseUrl: ctx.config.get('SUPABASE_URL'),
      supabaseKey: ctx.config.get('SUPABASE_KEY')
    });

    this.deskLookup = new DeskLookup(this.rag);
    this.analyzer = new AIAnalyzer(this.hvac, this.dali, this.rag);

    ctx.log.info('SENTINEL skill loaded');
  }

  // =========================================================================
  // TOOL: Comfort Check
  // =========================================================================

  async comfort_check(ctx: SkillContext, params: { location: string }): Promise<ToolResult> {
    const { location } = params;
    ctx.log.info(`Checking comfort at: ${location}`);

    try {
      // Step 1: Resolve location to zone
      const zoneInfo = await this.deskLookup.resolve(location);

      if (!zoneInfo) {
        return {
          success: false,
          message: `I couldn't find "${location}". Can you be more specific? (e.g., "desk 25", "meeting room 4B", "level 12 north")`
        };
      }

      // Step 2: Get HVAC data
      const hvacData = await this.hvac.getZoneData(zoneInfo.zone_id);

      // Step 3: Get lighting/occupancy data
      const daliData = await this.dali.getZoneData(zoneInfo.zone_id);

      // Step 4: Get context from RAG
      const context = await this.rag.getLocationContext(zoneInfo);

      // Step 5: AI analysis
      const analysis = await this.analyzer.analyzeComfort({
        location: zoneInfo,
        hvac: hvacData,
        dali: daliData,
        context
      });

      return {
        success: true,
        data: {
          location: zoneInfo,
          hvac: hvacData,
          lighting: daliData,
          analysis
        },
        message: this.formatComfortReport(analysis)
      };

    } catch (error) {
      ctx.log.error(`Comfort check failed: ${error}`);
      return {
        success: false,
        message: `Sorry, I couldn't check the comfort conditions. Error: ${error.message}`
      };
    }
  }

  // =========================================================================
  // TOOL: Zone Status
  // =========================================================================

  async zone_status(ctx: SkillContext, params: { zone_id: string }): Promise<ToolResult> {
    const { zone_id } = params;
    ctx.log.info(`Getting zone status: ${zone_id}`);

    try {
      // HVAC Status
      const hvac = await this.hvac.getZoneData(zone_id);

      // Lighting Status
      const lighting = await this.dali.getZoneLighting(zone_id);

      // Occupancy Status
      const occupancy = await this.dali.getZoneOccupancy(zone_id);

      // Active Alarms
      const alarms = await this.hvac.getZoneAlarms(zone_id);

      return {
        success: true,
        data: {
          zone_id,
          hvac,
          lighting,
          occupancy,
          alarms
        },
        message: this.formatZoneStatus({ zone_id, hvac, lighting, occupancy, alarms })
      };

    } catch (error) {
      ctx.log.error(`Zone status failed: ${error}`);
      return { success: false, message: error.message };
    }
  }

  // =========================================================================
  // TOOL: Building Overview
  // =========================================================================

  async building_overview(ctx: SkillContext, params: { building?: string }): Promise<ToolResult> {
    const building = params.building || '';
    ctx.log.info(`Getting building overview: ${building}`);

    try {
      // Get all zones
      const zones = await this.hvac.getAllZones(building);

      // Aggregate data
      const summary = {
        building,
        timestamp: new Date().toISOString(),

        // HVAC Summary
        hvac: {
          zones_normal: 0,
          zones_above_setpoint: 0,
          zones_below_setpoint: 0,
          active_alarms: 0,
          avg_temperature: 0
        },

        // Occupancy Summary (from lighting sensors)
        occupancy: {
          total_sensors: 0,
          occupied_sensors: 0,
          occupancy_percent: 0,
          busiest_zones: [],
          empty_zones: []
        },

        // Lighting Summary
        lighting: {
          total_luminaires: 0,
          active_luminaires: 0,
          faulty_luminaires: 0,
          avg_daylight_lux: 0,
          total_power_kw: 0
        },

        // Issues
        issues: {
          critical: [],
          warnings: []
        }
      };

      // Process each zone
      let tempSum = 0;
      let luxSum = 0;
      let zoneCount = 0;

      for (const zone of zones) {
        const hvacData = await this.hvac.getZoneData(zone.zone_id);
        const daliData = await this.dali.getZoneData(zone.zone_id);

        // HVAC
        tempSum += hvacData.temperature || 0;
        zoneCount++;

        if (hvacData.temperature > hvacData.setpoint + 1.5) {
          summary.hvac.zones_above_setpoint++;
        } else if (hvacData.temperature < hvacData.setpoint - 1.5) {
          summary.hvac.zones_below_setpoint++;
        } else {
          summary.hvac.zones_normal++;
        }

        summary.hvac.active_alarms += hvacData.alarms?.length || 0;

        // Occupancy
        summary.occupancy.total_sensors += daliData.occupancy.total_sensors;
        summary.occupancy.occupied_sensors += daliData.occupancy.occupied_sensors;

        if (daliData.occupancy.occupancy_percent > 70) {
          summary.occupancy.busiest_zones.push({
            zone_id: zone.zone_id,
            occupancy: daliData.occupancy.occupancy_percent
          });
        } else if (daliData.occupancy.occupancy_percent === 0) {
          summary.occupancy.empty_zones.push(zone.zone_id);
        }

        // Lighting
        summary.lighting.total_luminaires += daliData.lighting.total_luminaires;
        summary.lighting.active_luminaires += daliData.lighting.active_luminaires;
        summary.lighting.faulty_luminaires += daliData.lighting.faulty_count || 0;
        luxSum += daliData.lighting.avg_daylight_lux;
        summary.lighting.total_power_kw += daliData.lighting.total_power_w / 1000;
      }

      // Calculate averages
      summary.hvac.avg_temperature = tempSum / zoneCount;
      summary.lighting.avg_daylight_lux = luxSum / zoneCount;
      summary.occupancy.occupancy_percent =
        (summary.occupancy.occupied_sensors / summary.occupancy.total_sensors) * 100;

      // Sort busiest zones
      summary.occupancy.busiest_zones.sort((a, b) => b.occupancy - a.occupancy);
      summary.occupancy.busiest_zones = summary.occupancy.busiest_zones.slice(0, 5);

      return {
        success: true,
        data: summary,
        message: this.formatBuildingOverview(summary)
      };

    } catch (error) {
      ctx.log.error(`Building overview failed: ${error}`);
      return { success: false, message: error.message };
    }
  }

  // =========================================================================
  // TOOL: Adjust Comfort
  // =========================================================================

  async adjust_comfort(
    ctx: SkillContext,
    params: { location: string; action: string; duration_hours?: number }
  ): Promise<ToolResult> {
    const { location, action, duration_hours = 2 } = params;
    ctx.log.info(`Adjusting comfort at ${location}: ${action}`);

    try {
      // Resolve location
      const zoneInfo = await this.deskLookup.resolve(location);

      if (!zoneInfo) {
        return {
          success: false,
          message: `I couldn't find "${location}".`
        };
      }

      // Determine adjustment
      let adjustment: any = {};

      switch (action) {
        case 'cooler':
        case 'boost_cooling':
          adjustment = {
            type: 'setpoint',
            target: 'cooling',
            change: -2,  // Lower by 2°C
            duration: duration_hours * 3600
          };
          break;
        case 'warmer':
        case 'boost_heating':
          adjustment = {
            type: 'setpoint',
            target: 'heating',
            change: +2,  // Raise by 2°C
            duration: duration_hours * 3600
          };
          break;
        case 'brighter':
          adjustment = {
            type: 'lighting',
            target: 'level',
            value: 100,
            duration: duration_hours * 3600
          };
          break;
        case 'dimmer':
          adjustment = {
            type: 'lighting',
            target: 'level',
            value: 50,
            duration: duration_hours * 3600
          };
          break;
      }

      // Execute adjustment
      if (adjustment.type === 'setpoint') {
        const result = await this.hvac.adjustSetpoint(
          zoneInfo.zone_id,
          adjustment.change,
          adjustment.duration
        );

        return {
          success: true,
          data: result,
          message: `Done! I've ${action === 'cooler' ? 'boosted cooling' : 'boosted heating'} for ${zoneInfo.name}. ` +
                   `New setpoint: ${result.new_setpoint}°C. ` +
                   `This will automatically revert in ${duration_hours} hours.`
        };
      } else {
        // Lighting adjustment would need Scenecom API
        return {
          success: false,
          message: `Lighting adjustments are controlled by the building automation. ` +
                   `I can notify the FM team to adjust lighting in ${zoneInfo.name}.`
        };
      }

    } catch (error) {
      ctx.log.error(`Adjust comfort failed: ${error}`);
      return { success: false, message: error.message };
    }
  }

  // =========================================================================
  // FORMATTING HELPERS
  // =========================================================================

  private formatComfortReport(analysis: any): string {
    const { location, hvac, lighting, diagnosis, suggestions } = analysis;

    let report = `**${location.name}** (${location.zone_id})\n\n`;

    // HVAC Status
    report += `**Temperature**: ${hvac.temperature}°C (setpoint: ${hvac.setpoint}°C)\n`;
    report += `**Cooling**: ${hvac.fcu_status}\n`;

    // Occupancy (from lighting sensors)
    report += `**Occupancy**: ${lighting.occupancy.occupancy_percent.toFixed(0)}% `;
    report += `(${lighting.occupancy.occupied_sensors}/${lighting.occupancy.total_sensors} sensors)\n`;

    // Daylight
    report += `**Daylight**: ${lighting.avg_daylight_lux.toFixed(0)} lux\n`;

    // Diagnosis
    report += `\n**Diagnosis**: ${diagnosis}\n`;

    // Suggestions
    if (suggestions && suggestions.length > 0) {
      report += `\n**Options**:\n`;
      suggestions.forEach((s: any, i: number) => {
        report += `${String.fromCharCode(65 + i)}) ${s.description}\n`;
      });
      report += `\nReply with A, B, or C to take action.`;
    }

    return report;
  }

  private formatZoneStatus(data: any): string {
    const { zone_id, hvac, lighting, occupancy, alarms } = data;

    let report = `**Zone: ${zone_id}**\n\n`;

    // HVAC
    report += `**HVAC**\n`;
    report += `• Temperature: ${hvac.temperature}°C (SP: ${hvac.setpoint}°C)\n`;
    report += `• FCU: ${hvac.fcu_running ? 'Running' : 'Off'} at ${hvac.fcu_speed}%\n`;
    report += `• CHW Valve: ${hvac.chw_valve}%\n`;

    // Lighting
    report += `\n**Lighting**\n`;
    report += `• Luminaires: ${lighting.active_luminaires}/${lighting.total_luminaires} on\n`;
    report += `• Avg Level: ${lighting.avg_dim_level.toFixed(0)}%\n`;
    report += `• Daylight: ${lighting.avg_daylight_lux.toFixed(0)} lux\n`;

    // Occupancy
    report += `\n**Occupancy**\n`;
    report += `• ${occupancy.occupancy_percent.toFixed(0)}% occupied\n`;
    report += `• ${occupancy.occupied_sensors}/${occupancy.total_sensors} sensors active\n`;

    // Alarms
    if (alarms && alarms.length > 0) {
      report += `\n**Active Alarms**: ${alarms.length}\n`;
      alarms.slice(0, 3).forEach((a: any) => {
        report += `• ${a.message}\n`;
      });
    }

    return report;
  }

  private formatBuildingOverview(summary: any): string {
    let report = `**${summary.building} Building Status**\n`;
    report += `${new Date(summary.timestamp).toLocaleString()}\n\n`;

    // HVAC
    report += `**HVAC**\n`;
    report += `• Avg Temperature: ${summary.hvac.avg_temperature.toFixed(1)}°C\n`;
    report += `• Zones Normal: ${summary.hvac.zones_normal}\n`;
    report += `• Zones Warm: ${summary.hvac.zones_above_setpoint}\n`;
    report += `• Zones Cool: ${summary.hvac.zones_below_setpoint}\n`;
    report += `• Active Alarms: ${summary.hvac.active_alarms}\n`;

    // Occupancy
    report += `\n**Occupancy** (from ${summary.occupancy.total_sensors} sensors)\n`;
    report += `• Overall: ${summary.occupancy.occupancy_percent.toFixed(0)}%\n`;
    if (summary.occupancy.busiest_zones.length > 0) {
      report += `• Busiest: ${summary.occupancy.busiest_zones[0].zone_id} `;
      report += `(${summary.occupancy.busiest_zones[0].occupancy.toFixed(0)}%)\n`;
    }
    report += `• Empty Zones: ${summary.occupancy.empty_zones.length}\n`;

    // Lighting
    report += `\n**Lighting**\n`;
    report += `• Active: ${summary.lighting.active_luminaires}/${summary.lighting.total_luminaires}\n`;
    report += `• Faulty: ${summary.lighting.faulty_luminaires}\n`;
    report += `• Power: ${summary.lighting.total_power_kw.toFixed(1)} kW\n`;
    report += `• Daylight: ${summary.lighting.avg_daylight_lux.toFixed(0)} lux avg\n`;

    // Issues
    if (summary.issues.critical.length > 0) {
      report += `\n**Critical Issues**: ${summary.issues.critical.length}\n`;
    }
    if (summary.issues.warnings.length > 0) {
      report += `**Warnings**: ${summary.issues.warnings.length}\n`;
    }

    return report;
  }
}
```

### AI Analyzer (lib/ai-analyzer.ts)

```typescript
/**
 * AI Analyzer - Combines HVAC + Lighting data for intelligent diagnosis
 */

import { HVACClient } from './hvac-client';
import { DALIClient } from './dali-client';
import { RAGClient } from './rag-client';

interface ComfortInput {
  location: {
    desk_id?: string;
    zone_id: string;
    name: string;
    near_window?: boolean;
    floor?: string;
  };
  hvac: {
    temperature: number;
    setpoint: number;
    fcu_running: boolean;
    fcu_speed: number;
    chw_valve: number;
    alarms: any[];
  };
  dali: {
    occupancy: {
      occupied_sensors: number;
      total_sensors: number;
      occupancy_percent: number;
    };
    lighting: {
      avg_dim_level: number;
      avg_daylight_lux: number;
      max_daylight_lux: number;
      active_luminaires: number;
      total_luminaires: number;
    };
  };
  context: {
    equipment_info?: string;
    historical_complaints?: any[];
    weather?: any;
  };
}

interface ComfortAnalysis {
  location: any;
  hvac: any;
  lighting: any;
  diagnosis: string;
  root_cause: string;
  confidence: number;
  suggestions: Suggestion[];
}

interface Suggestion {
  id: string;
  description: string;
  action_type: 'hvac_adjust' | 'manual' | 'dispatch' | 'none';
  risk: 'low' | 'medium' | 'high';
  can_auto_execute: boolean;
  parameters?: any;
}

export class AIAnalyzer {
  constructor(
    private hvac: HVACClient,
    private dali: DALIClient,
    private rag: RAGClient
  ) {}

  async analyzeComfort(input: ComfortInput): Promise<ComfortAnalysis> {
    const { location, hvac, dali, context } = input;

    // Calculate key metrics
    const tempDelta = hvac.temperature - hvac.setpoint;
    const isAboveSetpoint = tempDelta > 0.5;
    const isBelowSetpoint = tempDelta < -0.5;
    const occupancyLow = dali.occupancy.occupancy_percent < 30;
    const highDaylight = dali.lighting.max_daylight_lux > 800;
    const fcuWorking = hvac.fcu_running && hvac.chw_valve > 20;
    const hasHvacAlarms = hvac.alarms && hvac.alarms.length > 0;

    // Determine diagnosis
    let diagnosis = '';
    let rootCause = '';
    let confidence = 0;
    const suggestions: Suggestion[] = [];

    // =========================================================================
    // DIAGNOSIS LOGIC
    // =========================================================================

    // Case 1: HVAC Fault
    if (hasHvacAlarms) {
      diagnosis = `There's an active HVAC alarm in this zone. ` +
                  `The ${hvac.alarms[0]?.type || 'equipment'} may need attention.`;
      rootCause = 'hvac_fault';
      confidence = 0.95;

      suggestions.push({
        id: 'dispatch',
        description: 'Dispatch technician to investigate alarm',
        action_type: 'dispatch',
        risk: 'low',
        can_auto_execute: false,
        parameters: { alarm: hvac.alarms[0] }
      });
    }

    // Case 2: Too Hot - FCU Not Working
    else if (isAboveSetpoint && !fcuWorking) {
      diagnosis = `Zone is ${tempDelta.toFixed(1)}°C above setpoint and the FCU appears ` +
                  `to not be cooling effectively. CHW valve at ${hvac.chw_valve}% ` +
                  `but may not be getting flow.`;
      rootCause = 'fcu_not_cooling';
      confidence = 0.85;

      suggestions.push({
        id: 'check_fcu',
        description: 'Check FCU - possible valve or flow issue',
        action_type: 'dispatch',
        risk: 'low',
        can_auto_execute: false
      });
    }

    // Case 3: Too Hot - Solar Gain (detected via high lux)
    else if (isAboveSetpoint && highDaylight && location.near_window) {
      diagnosis = `Zone is ${tempDelta.toFixed(1)}°C above setpoint. ` +
                  `The daylight sensor shows ${dali.lighting.max_daylight_lux.toFixed(0)} lux ` +
                  `which indicates strong sunlight. ` +
                  `${location.desk_id ? `Desk ${location.desk_id} is near a window` : 'This area is near windows'} - ` +
                  `solar heat gain is likely the cause. ` +
                  `The FCU is working (${hvac.fcu_speed}%) but struggling against the sun.`;
      rootCause = 'solar_gain';
      confidence = 0.90;

      suggestions.push({
        id: 'close_blinds',
        description: 'Close blinds to reduce solar heat gain',
        action_type: 'manual',
        risk: 'low',
        can_auto_execute: false
      });

      suggestions.push({
        id: 'boost_cooling',
        description: `Temporarily boost cooling (${hvac.setpoint}°C → ${hvac.setpoint - 2}°C for 2 hours)`,
        action_type: 'hvac_adjust',
        risk: 'low',
        can_auto_execute: true,
        parameters: {
          zone_id: location.zone_id,
          new_setpoint: hvac.setpoint - 2,
          duration: 7200
        }
      });
    }

    // Case 4: Too Hot - FCU Working Hard (normal operation, may need patience)
    else if (isAboveSetpoint && fcuWorking && hvac.fcu_speed > 70) {
      diagnosis = `Zone is ${tempDelta.toFixed(1)}°C above setpoint. ` +
                  `The FCU is running at ${hvac.fcu_speed}% with CHW valve at ${hvac.chw_valve}%. ` +
                  `The system is working hard to cool down - ` +
                  `it may need a few more minutes to reach setpoint.`;
      rootCause = 'still_cooling';
      confidence = 0.75;

      suggestions.push({
        id: 'wait',
        description: 'Wait 10-15 minutes for system to catch up',
        action_type: 'none',
        risk: 'low',
        can_auto_execute: false
      });

      suggestions.push({
        id: 'boost_cooling',
        description: 'Temporarily boost cooling if urgent',
        action_type: 'hvac_adjust',
        risk: 'low',
        can_auto_execute: true,
        parameters: {
          zone_id: location.zone_id,
          new_setpoint: hvac.setpoint - 2,
          duration: 7200
        }
      });
    }

    // Case 5: Too Hot - Low Occupancy (perception issue)
    else if (isAboveSetpoint && occupancyLow) {
      diagnosis = `Zone is ${tempDelta.toFixed(1)}°C above setpoint. ` +
                  `However, occupancy is low (${dali.occupancy.occupancy_percent.toFixed(0)}% - ` +
                  `${dali.occupancy.occupied_sensors} sensors active). ` +
                  `With fewer people, there's less internal heat which can make ` +
                  `the space feel different. The FCU is operating normally.`;
      rootCause = 'low_occupancy_perception';
      confidence = 0.70;

      suggestions.push({
        id: 'minor_adjust',
        description: 'Make a small comfort adjustment',
        action_type: 'hvac_adjust',
        risk: 'low',
        can_auto_execute: true,
        parameters: {
          zone_id: location.zone_id,
          new_setpoint: hvac.setpoint - 1,
          duration: 7200
        }
      });
    }

    // Case 6: Too Cold
    else if (isBelowSetpoint) {
      diagnosis = `Zone is ${Math.abs(tempDelta).toFixed(1)}°C below setpoint. `;

      if (hvac.fcu_speed < 30) {
        diagnosis += `The FCU is running low to prevent over-cooling. ` +
                     `You may want to raise the setpoint.`;
        rootCause = 'setpoint_too_low';
      } else {
        diagnosis += `The cooling may be too aggressive for current conditions.`;
        rootCause = 'overcooling';
      }
      confidence = 0.80;

      suggestions.push({
        id: 'raise_setpoint',
        description: `Raise setpoint to ${hvac.setpoint + 2}°C`,
        action_type: 'hvac_adjust',
        risk: 'low',
        can_auto_execute: true,
        parameters: {
          zone_id: location.zone_id,
          new_setpoint: hvac.setpoint + 2,
          duration: 7200
        }
      });
    }

    // Case 7: Normal - No Issues
    else {
      diagnosis = `Zone conditions appear normal. ` +
                  `Temperature is ${hvac.temperature}°C (setpoint ${hvac.setpoint}°C). ` +
                  `Occupancy is ${dali.occupancy.occupancy_percent.toFixed(0)}%. ` +
                  `If you're still uncomfortable, it may be a personal preference ` +
                  `or localized issue (draft, direct sun on desk, etc).`;
      rootCause = 'none_detected';
      confidence = 0.65;

      suggestions.push({
        id: 'personal_adjust',
        description: 'Request a small personal comfort adjustment',
        action_type: 'hvac_adjust',
        risk: 'low',
        can_auto_execute: true,
        parameters: {
          zone_id: location.zone_id,
          new_setpoint: hvac.setpoint - 1,
          duration: 3600  // 1 hour only
        }
      });

      suggestions.push({
        id: 'move',
        description: 'I can suggest an alternative desk in a more comfortable zone',
        action_type: 'none',
        risk: 'low',
        can_auto_execute: false
      });
    }

    return {
      location,
      hvac,
      lighting: dali,
      diagnosis,
      root_cause: rootCause,
      confidence,
      suggestions
    };
  }

  /**
   * Generate morning briefing for FM manager
   */
  async generateMorningBriefing(building: string): Promise<string> {
    // Get building-wide data
    const zones = await this.hvac.getAllZones(building);
    const alarms = await this.hvac.getActiveAlarms(building);

    let occupancyTotal = 0;
    let occupancyActive = 0;
    let zonesHot = 0;
    let zonesCold = 0;
    let lightingFaults = 0;

    for (const zone of zones) {
      const hvac = await this.hvac.getZoneData(zone.zone_id);
      const dali = await this.dali.getZoneData(zone.zone_id);

      occupancyTotal += dali.occupancy.total_sensors;
      occupancyActive += dali.occupancy.occupied_sensors;

      if (hvac.temperature > hvac.setpoint + 1.5) zonesHot++;
      if (hvac.temperature < hvac.setpoint - 1.5) zonesCold++;

      lightingFaults += dali.lighting.faulty_count || 0;
    }

    const occupancyPercent = (occupancyActive / occupancyTotal * 100).toFixed(0);

    let briefing = `**Good Morning! Here's your ${building} briefing:**\n\n`;

    // Alarms
    if (alarms.length > 0) {
      briefing += `**${alarms.length} Active Alarms**\n`;
      alarms.slice(0, 3).forEach((a: any) => {
        briefing += `  • ${a.equipment}: ${a.message}\n`;
      });
      briefing += '\n';
    } else {
      briefing += `**No Critical Alarms**\n\n`;
    }

    // HVAC
    briefing += `**HVAC Status**\n`;
    briefing += `  • Zones too warm: ${zonesHot}\n`;
    briefing += `  • Zones too cold: ${zonesCold}\n`;
    briefing += `  • Zones normal: ${zones.length - zonesHot - zonesCold}\n\n`;

    // Occupancy
    briefing += `**Current Occupancy**: ${occupancyPercent}%\n`;
    briefing += `  (${occupancyActive} of ${occupancyTotal} sensors active)\n\n`;

    // Lighting
    if (lightingFaults > 0) {
      briefing += `**Lighting**: ${lightingFaults} faulty luminaires detected\n\n`;
    }

    // Weather (if available)
    // briefing += `**Weather**: 28°C, Sunny (high solar gain expected)\n\n`;

    briefing += `Reply "details" for more information on any item.`;

    return briefing;
  }
}
```

