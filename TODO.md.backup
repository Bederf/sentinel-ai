            }
        },
        "abb": {
            "acs580": {
                "F0001": {"name": "Overcurrent", "severity": "critical"},
                "F0002": {"name": "Overvoltage", "severity": "critical"},
                "F0003": {"name": "Undervoltage", "severity": "high"},
                "F0004": {"name": "Output Phase Loss", "severity": "critical"},
                "F0005": {"name": "Inverter Overtemperature", "severity": "critical"},
                "F0007": {"name": "AI Supervision", "severity": "medium"},
                "F0009": {"name": "Motor Overtemperature", "severity": "high"},
                "F0010": {"name": "Input Phase Loss", "severity": "high"},
                "F0011": {"name": "Output Short Circuit", "severity": "critical"},
                "F0012": {"name": "Earth Fault", "severity": "critical"},
