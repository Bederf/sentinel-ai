## IMPLEMENTATION

### Python Web Scraper

```python
# equipment_lookup.py

import asyncio
import aiohttp
from bs4 import BeautifulSoup
from typing import Optional, List, Dict
import json
import re

class EquipmentLookup:
    """
    Web scraper for equipment fault codes, fixes, and parts.
    """

    # Manufacturer fault code URLs
    MANUFACTURER_SOURCES = {
        "carrier": {
            "base_url": "https://www.carrier.com",
            "fault_search": "/commercial/en/us/support/fault-codes/",
            "parts_url": "https://www.carrierparts.com"
        },
        "trane": {
            "base_url": "https://www.trane.com",
            "fault_search": "/commercial/support/fault-codes/",
            "parts_url": "https://www.?"
        },
        "daikin": {
            "base_url": "https://www.daikinac.com",
            "fault_search": "/support/error-codes/",
            "parts_url": "https://www.?"
        },
        # Add more manufacturers...
    }

    # SA Parts suppliers
    SA_PARTS_SUPPLIERS = [
        {
            "name": "Carrier SA",
            "url": "https://www.carriersa.co.za",
            "search_url": "/parts/search?q={query}",
            "brands": ["carrier"]
        },
        {
            "name": "Refrigeration Supplies",
            "url": "https://www.?"refrigerationsupplies.co.za",
            "search_url": "/search?q={query}",
            "brands": ["all"]
        },
        {
            "name": "RS Components SA",
            "url": "https://za.rs-online.com",
            "search_url": "/web/c/?searchTerm={query}",
            "brands": ["all"]
        },
        {
            "name": "Voltex",
            "url": "https://www.voltex.co.za",
            "search_url": "/search/{query}",
            "brands": ["electrical", "drives"]
        },
        {
            "name": "Bearing Man",
            "url": "https://www.bearingman.co.za",
            "search_url": "/products?search={query}",
            "brands": ["bearings", "seals"]
        }
    ]

    # Common fault code patterns by manufacturer
    FAULT_CODE_PATTERNS = {
        "carrier": {
            "30xa": {
                "E1": {"name": "High Discharge Pressure", "severity": "critical"},
                "E2": {"name": "Low Suction Pressure", "severity": "critical"},
                "E3": {"name": "High Oil Temperature", "severity": "high"},
                "E4": {"name": "Low Oil Pressure", "severity": "critical"},
                "E5": {"name": "Motor Overload", "severity": "critical"},
                "E6": {"name": "Freeze Protection", "severity": "high"},
                "E7": {"name": "Low Evaporator Pressure", "severity": "high"},
                "E8": {"name": "High Condenser Pressure", "severity": "high"},
                # ... more codes
            }
        },
        "trane": {
            "rtac": {
                "AL01": {"name": "High Pressure Cutout", "severity": "critical"},
                "AL02": {"name": "Low Pressure Cutout", "severity": "critical"},
                "AL03": {"name": "Oil Pressure Failure", "severity": "critical"},
                # ... more codes
            }
        },
        "daikin": {
            "vrv": {
                "A1": {"name": "Indoor PCB Defect", "severity": "critical"},
                "A3": {"name": "Drain Level Abnormal", "severity": "medium"},
                "A5": {"name": "Freeze Protection", "severity": "high"},
                "E1": {"name": "Outdoor PCB Defect", "severity": "critical"},
                "E3": {"name": "High Pressure Abnormal", "severity": "critical"},
                "E4": {"name": "Low Pressure Abnormal", "severity": "critical"},
                "E5": {"name": "Compressor Motor Lock", "severity": "critical"},
                "E6": {"name": "Compressor Motor Overcurrent", "severity": "critical"},
                "E7": {"name": "Outdoor Fan Motor Abnormal", "severity": "high"},
                "F3": {"name": "Discharge Pipe Temp Abnormal", "severity": "high"},
                "F6": {"name": "Refrigerant Overcharge", "severity": "medium"},
                "H1": {"name": "Defrost Operation", "severity": "info"},
                "H6": {"name": "Compressor Sensor Abnormal", "severity": "medium"},
                "H8": {"name": "CT Sensor Abnormal", "severity": "medium"},
                "J3": {"name": "Discharge Pipe Thermistor", "severity": "medium"},
                "J6": {"name": "Heat Exchanger Thermistor", "severity": "medium"},
                "L1": {"name": "Inverter PCB Defect", "severity": "critical"},
                "L3": {"name": "Electrical Box Temp Rise", "severity": "high"},
                "L4": {"name": "Inverter Radiator Temp Rise", "severity": "high"},
