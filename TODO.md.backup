- `frontend/src/pages/LicencePage.tsx` - Create full licence page
- `frontend/src/components/Dashboard.tsx` - Add licence status widget (if near limits)

**Database Schema** (Migration 011):

```sql
-- Licences table
CREATE TABLE licences (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  organisation_id UUID NOT NULL,
  agreement_ref VARCHAR(50) UNIQUE NOT NULL, -- e.g., SLA-2026-014
  status VARCHAR(20) NOT NULL CHECK (status IN ('active', 'suspended', 'expired')),
  start_date DATE NOT NULL,
  end_date DATE NOT NULL,
  bms_points_limit INTEGER NOT NULL DEFAULT 3000,
  users_limit INTEGER NOT NULL DEFAULT 25,
  created_at TIMESTAMP DEFAULT NOW(),
  updated_at TIMESTAMP DEFAULT NOW()
);

-- Licensed sites
CREATE TABLE licensed_sites (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  licence_id UUID REFERENCES licences(id) ON DELETE CASCADE,
  site_id VARCHAR(50) NOT NULL, -- Reference to sites.site_id
  created_at TIMESTAMP DEFAULT NOW(),
  UNIQUE(licence_id, site_id)
);

-- Licensed modules
CREATE TABLE licensed_modules (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  licence_id UUID REFERENCES licences(id) ON DELETE CASCADE,
  module_code VARCHAR(50) NOT NULL, -- core_platform, predictive_maintenance, load_shedding
  created_at TIMESTAMP DEFAULT NOW(),
  UNIQUE(licence_id, module_code)
);

-- Usage metrics (snapshot tracking)
CREATE TABLE usage_metrics (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  licence_id UUID REFERENCES licences(id) ON DELETE CASCADE,
  metric_type VARCHAR(20) NOT NULL CHECK (metric_type IN ('bms_points', 'users')),
  current_value INTEGER NOT NULL DEFAULT 0,
  recorded_at TIMESTAMP DEFAULT NOW(),
  UNIQUE(licence_id, metric_type)
);

-- Indexes
CREATE INDEX idx_licences_organisation ON licences(organisation_id);
CREATE INDEX idx_licences_status ON licences(status);
CREATE INDEX idx_licences_dates ON licences(start_date, end_date);
CREATE INDEX idx_licensed_sites_licence ON licensed_sites(licence_id);
CREATE INDEX idx_licensed_modules_licence ON licensed_modules(licence_id);
CREATE INDEX idx_usage_metrics_licence ON usage_metrics(licence_id);
```

**API Endpoints**:

```
GET  /api/licence/status          # Get current licence status
GET  /api/licence/scope           # Get licensed sites and modules
GET  /api/licence/usage           # Get current usage metrics (points, users)
GET  /api/licence/support         # Get support information
GET  /api/licence/agreement       # Download licence agreement PDF
POST /api/licence/check-access    # Verify access to specific site/module
GET  /api/licence/settings        # Admin: Get licence settings
PUT  /api/licence/settings        # Admin: Update licence limits
```

