    async def lookup_fault_code(
        self,
        manufacturer: str,
        fault_code: str,
        model: Optional[str] = None,
        equipment_type: Optional[str] = None
    ) -> Dict:
        """
        Main lookup function - combines local DB + web scraping
        """
        result = {
            "fault": None,
            "probable_causes": [],
            "recommended_fix": {},
            "parts_suggested": [],
            "sources": []
        }

        # 1. Check local fault code database first
        local_result = self._lookup_local_db(manufacturer, model, fault_code)
        if local_result:
            result["fault"] = local_result
            result["sources"].append({
                "type": "local_db",
                "source": "SENTINEL Fault Code Database"
            })

        # 2. Scrape manufacturer website
        manufacturer_result = await self._scrape_manufacturer(
            manufacturer, model, fault_code
        )
        if manufacturer_result:
            result["probable_causes"] = manufacturer_result.get("causes", [])
            result["recommended_fix"] = manufacturer_result.get("fix", {})
            result["sources"].append(manufacturer_result.get("source"))

        # 3. Search forums for real-world fixes
        forum_results = await self._search_forums(
            manufacturer, model, fault_code
        )
        if forum_results:
            result["sources"].extend(forum_results.get("sources", []))
            # Merge any additional causes/fixes from forums

        # 4. Search parts suppliers
        parts = await self._search_parts(
            manufacturer, model, fault_code, result.get("probable_causes", [])
        )
        result["parts_suggested"] = parts

        return result

    def _lookup_local_db(
        self,
        manufacturer: str,
        model: Optional[str],
        fault_code: str
    ) -> Optional[Dict]:
        """Check local fault code database"""
        manufacturer = manufacturer.lower()

        if manufacturer in self.FAULT_CODE_PATTERNS:
            mfr_codes = self.FAULT_CODE_PATTERNS[manufacturer]

            # Try specific model first
            if model and model.lower() in mfr_codes:
                model_codes = mfr_codes[model.lower()]
                if fault_code.upper() in model_codes:
                    return model_codes[fault_code.upper()]

            # Try generic manufacturer codes
            for model_key, codes in mfr_codes.items():
                if fault_code.upper() in codes:
                    return codes[fault_code.upper()]

        return None

    async def _scrape_manufacturer(
        self,
        manufacturer: str,
        model: Optional[str],
        fault_code: str
    ) -> Optional[Dict]:
        """Scrape manufacturer website for fault code info"""
        manufacturer = manufacturer.lower()

        if manufacturer not in self.MANUFACTURER_SOURCES:
            return None

        source = self.MANUFACTURER_SOURCES[manufacturer]

        # Build search URL
        search_url = f"{source['base_url']}{source['fault_search']}"
        if model:
            search_url += f"?model={model}&code={fault_code}"
        else:
            search_url += f"?code={fault_code}"

        try:
            async with aiohttp.ClientSession() as session:
                async with session.get(search_url, timeout=10) as response:
                    if response.status == 200:
                        html = await response.text()
                        return self._parse_manufacturer_page(html, manufacturer)
        except Exception as e:
            print(f"Error scraping {manufacturer}: {e}")

        return None

    def _parse_manufacturer_page(self, html: str, manufacturer: str) -> Dict:
        """Parse manufacturer fault code page"""
        soup = BeautifulSoup(html, 'html.parser')

        result = {
            "causes": [],
            "fix": {},
            "source": {
                "type": "manufacturer",
                "source": f"{manufacturer.title()} Technical Documentation"
            }
        }

        # Parsing logic would be manufacturer-specific
        # This is a simplified example

        # Look for common patterns
        cause_sections = soup.find_all(['div', 'section'], class_=re.compile(r'cause|reason'))
        for section in cause_sections:
            result["causes"].append({
                "cause": section.get_text(strip=True),
                "likelihood": "unknown"
            })

        fix_sections = soup.find_all(['div', 'section'], class_=re.compile(r'fix|solution|remedy'))
        for section in fix_sections:
            result["fix"]["steps"] = [
                step.get_text(strip=True)
                for step in section.find_all('li')
            ]

        return result

    async def _search_forums(
        self,
        manufacturer: str,
        model: Optional[str],
        fault_code: str
    ) -> Dict:
        """Search technical forums for real-world solutions"""
        sources = []

        # Search HVAC-Talk
        hvac_talk_url = f"https://hvac-talk.com/search?q={manufacturer}+{fault_code}"

        # Search Reddit r/HVAC
        reddit_url = f"https://www.reddit.com/r/HVAC/search?q={manufacturer}+{fault_code}"

        # Search Eng-Tips
        eng_tips_url = f"https://www.eng-tips.com/search?q={manufacturer}+{fault_code}"

        # Would implement actual scraping here
        # For now, return structure

        return {"sources": sources}

    async def _search_parts(
        self,
        manufacturer: str,
        model: Optional[str],
        fault_code: str,
        probable_causes: List[Dict]
    ) -> List[Dict]:
        """Search SA parts suppliers for relevant parts"""
        parts = []

        # Determine what parts might be needed based on fault
        # This would use AI/rules to suggest relevant parts

        for supplier in self.SA_PARTS_SUPPLIERS:
            if supplier["brands"] == ["all"] or manufacturer.lower() in supplier["brands"]:
                # Search this supplier
                results = await self._search_supplier(supplier, manufacturer, model)
                parts.extend(results)

        return parts

    async def _search_supplier(
        self,
        supplier: Dict,
        manufacturer: str,
        model: Optional[str]
    ) -> List[Dict]:
        """Search a specific supplier for parts"""
        results = []

        query = f"{manufacturer} {model}" if model else manufacturer
        search_url = supplier["url"] + supplier["search_url"].format(query=query)

        try:
            async with aiohttp.ClientSession() as session:
                async with session.get(search_url, timeout=10) as response:
                    if response.status == 200:
                        html = await response.text()
                        results = self._parse_supplier_results(html, supplier["name"])
        except Exception as e:
            print(f"Error searching {supplier['name']}: {e}")

        return results

    def _parse_supplier_results(self, html: str, supplier_name: str) -> List[Dict]:
        """Parse supplier search results"""
        soup = BeautifulSoup(html, 'html.parser')
        results = []

        # Generic product parsing - would need customization per supplier
        products = soup.find_all(['div', 'article'], class_=re.compile(r'product'))

        for product in products[:5]:  # Limit to top 5
            name = product.find(['h2', 'h3', 'span'], class_=re.compile(r'name|title'))
            price = product.find(['span', 'div'], class_=re.compile(r'price'))
            part_num = product.find(['span'], class_=re.compile(r'sku|part'))

            if name:
                results.append({
                    "part_name": name.get_text(strip=True),
                    "part_number": part_num.get_text(strip=True) if part_num else "N/A",
                    "supplier": supplier_name,
                    "price": price.get_text(strip=True) if price else "Contact for price"
                })

        return results


# MCP Server wrapper
async def lookup_fault_code_tool(
    manufacturer: str,
    fault_code: str,
    model: str = None,
    equipment_type: str = None
) -> Dict:
    """MCP Tool: Look up fault code and get fix + parts"""
    lookup = EquipmentLookup()
    return await lookup.lookup_fault_code(
        manufacturer=manufacturer,
        fault_code=fault_code,
        model=model,
        equipment_type=equipment_type
    )
```

