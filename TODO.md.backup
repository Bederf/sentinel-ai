## IMPLEMENTATION

### Python MCP Server

```python
# simbiot_mcp_server.py

from mcp.server import Server
from mcp.types import Tool, Resource, Prompt
import asyncio

# Initialize MCP server
server = Server("simbiot-mcp")

# Register tools
@server.tool("get_buildings")
async def get_buildings(status_filter: str = "all", region: str = None):
    """List all buildings with summary status"""
    buildings = await db.query_buildings(status_filter, region)
    return {
        "buildings": [format_building_summary(b) for b in buildings],
        "total": len(buildings)
    }

@server.tool("get_assets")
async def get_assets(
    building_id: str,
    asset_type: str = "all",
    health_below: float = None,
    risk_above: float = None
):
    """List assets for a building"""
    assets = await db.query_assets(
        building_id=building_id,
        asset_type=asset_type,
        health_below=health_below,
        risk_above=risk_above
    )
    return {
        "building_id": building_id,
        "assets": [format_asset_summary(a) for a in assets],
        "total": len(assets)
    }

@server.tool("get_asset_detail")
async def get_asset_detail(asset_id: str, include: list = None):
    """Get detailed asset information"""
    asset = await db.get_asset(asset_id)
    result = {"asset": format_asset_full(asset)}

    if include:
        if "health_breakdown" in include:
            result["health"] = await calculate_health_score(asset_id)
        if "recent_alarms" in include:
            result["recent_alarms"] = await db.get_recent_alarms(asset_id, limit=10)
        if "predictions" in include:
            result["predictions"] = await get_predictions(asset_id)

    return result

@server.tool("get_alarms")
async def get_alarms(
    building_id: str = None,
    asset_id: str = None,
    severity: list = None,
    state: str = "all",
    from_time: str = None,
    to_time: str = None,
    limit: int = 50
):
    """Get alarms with filtering"""
    alarms = await db.query_alarms(
        building_id=building_id,
        asset_id=asset_id,
        severity=severity,
        state=state,
        from_time=from_time,
        to_time=to_time,
        limit=limit
    )
    return {"alarms": alarms, "total": len(alarms)}

@server.tool("search_alarms")
async def search_alarms(query: str, building_id: str = None, limit: int = 20):
    """Natural language alarm search"""
    # Parse natural language query
    parsed = parse_alarm_query(query)

    # Execute search
    results = await db.search_alarms(
        parsed=parsed,
        building_id=building_id,
        limit=limit
    )

    return {
        "interpretation": parsed.description,
        "results": results
    }

@server.tool("get_health_score")
async def get_health_score(asset_id: str):
    """Calculate health score with breakdown"""
    return await calculate_health_score(asset_id)

@server.tool("get_risk_score")
async def get_risk_score(asset_id: str):
    """Calculate risk score with predictions"""
    return await calculate_risk_score(asset_id)

@server.tool("create_work_order")
async def create_work_order(
    asset_id: str,
    title: str,
    description: str,
    priority: str,
    type: str = "reactive",
    prediction_id: str = None
):
    """Create work order in CAFM"""
    # Validate asset exists
    asset = await db.get_asset(asset_id)
    if not asset:
        return {"success": False, "error": "Asset not found"}

    # Create in CAFM via connector
    wo = await cafm_connector.create_work_order(
        asset=asset,
        title=title,
        description=description,
        priority=priority,
        type=type,
        source="SENTINEL AI",
        prediction_id=prediction_id
    )

    return {
        "success": True,
        "work_order": wo,
        "message": f"Work order {wo.number} created successfully"
    }

# Register resources
@server.resource("building://{building_id}/overview")
async def building_overview(building_id: str):
    """Building overview resource"""
    building = await db.get_building(building_id)
    assets = await db.query_assets(building_id=building_id)
    alarms = await db.get_active_alarms(building_id=building_id)

    return {
        "building": format_building_full(building),
        "summary": {
            "total_assets": len(assets),
            "critical_assets": len([a for a in assets if a.criticality == "critical"]),
            "active_alarms": len(alarms),
            "critical_alarms": len([a for a in alarms if a.severity == "critical"]),
            "average_health": sum(a.health_score for a in assets) / len(assets)
        },
        "high_risk_assets": [
            format_asset_summary(a) for a in assets
            if a.risk_score >= 70
        ][:5]
    }

# Register prompts
@server.prompt("analyze_asset")
async def analyze_asset_prompt(asset_id: str):
    """Generate asset analysis prompt"""
    asset = await get_asset_detail(asset_id, include=[
        "health_breakdown", "recent_alarms", "predictions", "work_orders"
    ])

    return {
        "messages": [
            {
                "role": "user",
                "content": f"""Analyze this asset and provide:
1. Current health assessment with key concerns
2. Risk of failure and timeframe
3. Evidence supporting the risk assessment
4. Recommended actions with priority
5. Estimated cost of inaction

Asset Data:
{json.dumps(asset, indent=2)}
"""
            }
        ]
    }

# Run server
if __name__ == "__main__":
    asyncio.run(server.run())
```

