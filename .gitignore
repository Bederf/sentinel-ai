# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
ENV/
*.egg-info/
.eggs/
dist/
build/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment (plaintext secrets — NEVER commit)
.env
.env.local
.env.*.local
# Encrypted secrets ARE safe to commit
!*.env.enc
!.env.*.enc

# Firmware credentials — NEVER commit real config.h
firmware/**/config.h

# Build outputs
frontend/dist/

# ML model artifacts (trained weights — regenerated by training pipeline)
backend/ml/models/**/*.h5
backend/ml/models/**/*.joblib
backend/ml/models/**/*.npy
backend/ml/models/**/*.keras

# Stale backups (one-off migration artifacts)
backups/

# Pip artifacts
backend/=*

# Docker
*.log
power_meters.csv

# Simulation runtime data (large, regenerated by simulation engine)
backend/app/data/simulation/

# Runtime logs and decision data (generated by SENTINEL, not source code)
backend/app/data/audit_log.json
backend/app/data/parasite_decisions.json
backend/app/data/ml_feedback_records.json

# Space intelligence runtime data (written by MQTT listener + ghost detector)
backend/app/data/space/occupancy_events.json
backend/app/data/space/ghost_findings.json
backend/app/data/space/room_current_state.json
backend/app/data/space/room_events.json
backend/app/data/space/room_state_findings.json
# Generated Brick ontology files (large, regenerated from equipment JSON)
backend/app/data/buildings/*/brick/*.ttl
security/bola-scanner/specs/openapi.json

# Planning and working documents (not source code)
.planning/
.rename-backup-*/

# ML registry archive (large, generated by registry_pruner — not source code)
backend/ml/models/registry.bak.json
# Compiled firmware binaries (regenerated from source)
firmware/**/*.bin
# code-review-graph knowledge graph (auto-generated)
.code-review-graph/
# Space intelligence runtime data
backend/app/data/onboarding_phase_state.json
backend/app/data/visit_store.lock
backend/app/data/space/node_room_mapping.json
backend/app/data/space/_local_node_mapping.json
backend/app/data/space/node_room_mapping.local.json
# Next.js build output
backend/.next/
# Python dependency lock
backend/uv.lock

# AI usage log (runtime data, not source code)
backend/app/data/ai_usage_log.json

# Repo-root tests/ (non-BMS project files — not SENTINEL source)
# Note: backend/tests/ is the SENTINEL test suite and must NOT be ignored
/tests/

# Mode policy state (runtime, per-site)
backend/app/data/policies/

# BACnet write audit logs (runtime, per-site — compliance archival)
backend/app/data/bacnet_audit/*.jsonl
