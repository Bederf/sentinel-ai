# Encrypted secrets ARE safe to commit
!*.env.enc
!.env.*.enc

# Firmware credentials — NEVER commit real config.h
firmware/**/config.h

# Build outputs
frontend/dist/

# ML model artifacts (trained weights — regenerated by training pipeline)
backend/ml/models/**/*.h5
backend/ml/models/**/*.joblib
backend/ml/models/**/*.npy
backend/ml/models/**/*.keras

# Stale backups (one-off migration artifacts)
backups/

# Pip artifacts
backend/=*

# Docker
*.log
power_meters.csv

# Simulation runtime data (large, regenerated by simulation engine)
backend/app/data/simulation/

# Runtime logs and decision data (generated by SENTINEL, not source code)
backend/app/data/audit_log.json
backend/app/data/parasite_decisions.json
backend/app/data/ml_feedback_records.json

# Space intelligence runtime data (written by MQTT listener + ghost detector)
backend/app/data/space/occupancy_events.json
backend/app/data/space/ghost_findings.json
backend/app/data/space/room_current_state.json
backend/app/data/space/room_events.json
backend/app/data/space/room_state_findings.json
# Generated Brick ontology files (large, regenerated from equipment JSON)
backend/app/data/buildings/*/brick/*.ttl
security/bola-scanner/specs/openapi.json

# Planning and working documents (not source code)
.planning/
.rename-backup-*/

