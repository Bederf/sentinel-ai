# SENTINEL Backend — Release Environment Template
# Copy to .env and fill in values for your deployment.

# Required — site identification
SITE_ID=site-002
PLANT_SITE_ID=site-002
BUILDING_NAME=BuildingName

# Required — JWT signing key (min 32 characters)
JWT_SECRET_KEY=generate_with_python_-c_import_secrets_print_secrets_token_hex_32

# Required — Supabase connection
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Required — Sentry webhook secret
SENTRY_WEBHOOK_SECRET=your_webhook_secret
INGESTION_MODE=shadow

# Required — POPIA compliance (long random string, min 32 chars)
CONSENT_HASH_SALT=generate_a_long_random_secret_for_popia_compliance

# Optional — override defaults
APP_NAME=SENTINEL
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# Storage provider: "supabase" or "filesystem"
STORAGE_PROVIDER=supabase
# STORAGE_LOCAL_PATH=/var/sentinel/storage

# Redis (caching layer)
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# InfluxDB (timeseries telemetry)
# INFLUXDB_URL=http://influxdb:8086
# INFLUXDB_TOKEN=
# INFLUXDB_ORG=
# INFLUXDB_BUCKET=sensor_data_raw
